function moveLane(dir) {
    if (!state.playing || state.over || state.paused) return;
    const n = state.currentLane + dir;
    if (n >= 0 && n <= 2) { state.currentLane = n; state.targetX = LANES[n]; }
}
function jump() {
    if (!state.playing || state.over || state.paused) return;
    state.jumpBuffer = 8;
}
document.addEventListener('keydown', e => {
    if (!state.playing) return;
    if (['ArrowLeft','ArrowRight','ArrowUp',' '].includes(e.key)) e.preventDefault();
    if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') moveLane(-1);
    else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') moveLane(1);
    else if (e.key === ' ' || e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') jump();
    else if (e.key === 'Escape') togglePause();
});
let tx = 0, ty = 0, tStart = 0;
document.addEventListener('touchstart', e => {
    if (!state.playing || e.target.closest('button') || e.target.closest('.overlay')) return;
    tx = e.touches[0].clientX; ty = e.touches[0].clientY; tStart = performance.now();
}, { passive:true });
document.addEventListener('touchend', e => {
    if (!state.playing || e.target.closest('button') || e.target.closest('.overlay')) return;
    const dx = e.changedTouches[0].clientX - tx;
    const dy = e.changedTouches[0].clientY - ty;
    const dist = Math.sqrt(dx*dx + dy*dy);
    const dur = performance.now() - tStart;
    if (dist < 20 && dur < 300) { jump(); return; }
    if (Math.abs(dx) > Math.abs(dy)) {
        if (dx > 30) moveLane(1); else if (dx < -30) moveLane(-1);
    } else { if (dy < -30) jump(); }
}, { passive:true });

// ================ КОЛЛИЗИИ ================
function checkCollisions() {
    if (state.bossActive && bossGroup.visible) {
        const dx = Math.abs(bossGroup.position.x - state.playerX);
        const dz = Math.abs(bossGroup.position.z);
        if (dx < 2.4 && dz < 1.5) {
            if (state.bonusShield > 0) {
                damageBoss();
                if (state.bossActive) bossGroup.position.z = -80;
            } else if (state.invuln > 0) {}
            else { gameOver(); return; }
        }
    }
    for (let i = state.obstacles.length - 1; i >= 0; i--) {
        const obs = state.obstacles[i];
        const dx = Math.abs(obs.position.x - state.playerX);
        const dz = Math.abs(obs.position.z);
        const pTop = state.playerY + 1.7, pBottom = state.playerY;
        const oTop = obs.position.y + obs.userData.height / 2;
        const oBottom = obs.position.y - obs.userData.height / 2;
        if (dx < 1.35 && dz < 1.25 && pTop > oBottom && pBottom < oTop) {
            if (state.invuln > 0) continue;
            if (state.bonusShield > 0) {
                scene.remove(obs); state.obstacles.splice(i, 1);
                emitParticles(obs.position.x, obs.position.y, obs.position.z, 0x4ce0ff, 12);
                audio.sfxBonus();
                continue;
            }
            gameOver(); return;
        }
    }
    for (let i = state.coins.length - 1; i >= 0; i--) {
        const c = state.coins[i];
        if (c.userData.collected) continue;
        const dx = Math.abs(c.position.x - state.playerX);
        const dz = Math.abs(c.position.z);
        const magnetRange = state.bonusMagnet > 0 ? 4 : 1.3;
        if (dx < magnetRange && dz < magnetRange && Math.abs(c.position.y - (state.playerY + 1)) < 1.8) {
            c.userData.collected = true;
            scene.remove(c); state.coins.splice(i, 1);
            const modeMul = getCurrentMode().coinMul;
            const skinMul = getSkinBonus('coins') ? 1.1 : (getSkinBonus('coins2') ? 1.25 : 1);
            const doubleMul = state.bonusDoubleCoins > 0 ? 2 : 1;
            const total = Math.ceil(1 * modeMul * skinMul * doubleMul);
            state.coinsThisRun += total;
            state.score += 2 * total;
            audio.sfxCoin();
            updateMissions('coins', 1);
        }
    }
    for (let i = state.bonuses.length - 1; i >= 0; i--) {
        const b = state.bonuses[i];
        if (b.userData.collected) continue;
        const dx = Math.abs(b.position.x - state.playerX);
        const dz = Math.abs(b.position.z);
        if (dx < 1.5 && dz < 1.5 && Math.abs(b.position.y - (state.playerY + 1)) < 1.8) {
            b.userData.collected = true;
            scene.remove(b); state.bonuses.splice(i, 1);
            activateBonus(b.userData.type);
        }
    }
}
function activateBonus(type) {
    audio.sfxBonus();
    if (type === 'shield') state.bonusShield = 300;
    else if (type === 'double') state.bonusDoubleCoins = 480;
    else if (type === 'magnet') state.bonusMagnet = 360;
    else if (type === 'speed') state.bonusSpeed = 300;
    updateBonusLabel();
    updateMissions('bonus', 1);
}
function updateBonusLabel() {
    const p = [];
    if (state.bonusShield > 0) p.push('🛡️ ' + Math.ceil(state.bonusShield/60) + 'с');
    if (state.bonusDoubleCoins > 0) p.push('💰 x2 ' + Math.ceil(state.bonusDoubleCoins/60) + 'с');
    if (state.bonusMagnet > 0) p.push('🧲 ' + Math.ceil(state.bonusMagnet/60) + 'с');
    if (state.bonusSpeed > 0) p.push('⚡ ' + Math.ceil(state.bonusSpeed/60) + 'с');
    const el = document.getElementById('bonusLabel');
    if (p.length) { el.textContent = p.join('  '); el.style.display = 'block'; }
    else el.style.display = 'none';
}

// ================ ИГРОВОЙ ЦИКЛ ================
const FIXED_DT = 1/60;
let accumulator = 0, lastTime = performance.now();

function update(dt) {
    if (!state.playing || state.over || state.paused) return;

    if (state.invuln > 0) state.invuln--;
    if (state.coyoteTime > 0) state.coyoteTime--;
    if (state.jumpBuffer > 0) state.jumpBuffer--;
    if (state.bonusShield > 0) state.bonusShield--;
    if (state.bonusDoubleCoins > 0) state.bonusDoubleCoins--;
    if (state.bonusMagnet > 0) state.bonusMagnet--;
    if (state.bonusSpeed > 0) state.bonusSpeed--;
    if (bossGroup.userData.hitFlash > 0) {
        bossGroup.userData.hitFlash--;
        bossBodyMat.emissiveIntensity = 1.5;
    } else {
        bossBodyMat.emissiveIntensity = .6;
    }

    if (state.mode === 'time' && state.timeLeft > 0) {
        state.timeLeft -= dt;
        document.getElementById('timerLabel').textContent = '⏱ ' + Math.ceil(Math.max(0, state.timeLeft));
        if (state.timeLeft <= 0) { gameOver(); return; }
    }

    state.playerX += (state.targetX - state.playerX) * 0.25;
    playerGroup.position.x = state.playerX;

    if (state.jumpBuffer > 0 && (state.onGround || state.coyoteTime > 0)) {
        let jv = JUMP_VELOCITY;
        if (getSkinBonus('jump')) jv *= 1.15;
        state.vy = jv;
        state.onGround = false;
        state.coyoteTime = 0;
        state.jumpBuffer = 0;
        audio.sfxJump();
    }
    if (!state.onGround) {
        state.vy -= GRAVITY * dt;
        if (state.vy < -MAX_FALL) state.vy = -MAX_FALL;
        state.playerY += state.vy * dt;
        if (state.playerY <= 0) { state.playerY = 0; state.vy = 0; state.onGround = true; }
    } else state.coyoteTime = 6;
    playerGroup.position.y = state.playerY;

    if (state.onGround) {
        state.walkCycle += dt * 12;
        const off = Math.sin(state.walkCycle) * 0.06;
        body.position.y = 1 + off;
        head.position.y = 1.95 + off;
        cap.position.y = 2.32 + off;
        visor.position.y = 2.27 + off;
        eyeL.position.y = 1.98 + off;
        eyeR.position.y = eyeL.position.y;
    }

    const modeMul = getCurrentMode().speedMul;
    const skinMul = getSkinBonus('speed') ? 1.05 : 1;
    const speedMult = state.bonusSpeed > 0 ? 1.5 : 1;
    const effectiveSpeed = state.baseSpeed * modeMul * skinMul * speedMult;

    lineGroup.children.forEach(l => {
        l.position.z += effectiveSpeed * dt;
        if (l.position.z > 10) l.position.z -= 225;
    });
    decorGroup.children.forEach(d => {
        d.position.z += effectiveSpeed * dt;
        if (d.position.z > 20) d.position.z -= 220;
    });

    for (let i = state.obstacles.length - 1; i >= 0; i--) {
        const obs = state.obstacles[i];
        obs.position.z += effectiveSpeed * dt;
        if (obs.userData.type === 'moving') {
            obs.userData.movePhase += dt * 3;
            obs.position.x = LANES[obs.userData.lane] + Math.sin(obs.userData.movePhase) * 1.6;
        } else if (obs.userData.type === 'rotating') {
            obs.userData.rotPhase += dt * 3.5;
            obs.rotation.y = obs.userData.rotPhase;
        }
        if (obs.position.z > 12) {
            scene.remove(obs); state.obstacles.splice(i, 1);
            state.score++;
            if (state.score >= state.nextZoneAt) {
                state.nextZoneAt += state.zoneThreshold;
                applyZone((currentZone + 1) % ZONES.length);
            }
            if (state.score >= state.bossNextAt && !state.bossActive) {
                state.bossNextAt += 200;
                spawnBoss();
            }
            updateMissions('score', 1);
        }
    }

    if (state.bossActive && bossGroup.visible) {
        bossGroup.position.z += effectiveSpeed * dt * 0.6;
        bossGroup.userData.phase += dt * 2;
        bossGroup.position.x = LANES[bossGroup.userData.lane] + Math.sin(bossGroup.userData.phase) * 3;
        bossGroup.rotation.z = Math.sin(bossGroup.userData.phase * 2) * 0.15;
        if (bossGroup.position.z > 12) { bossGroup.visible = false; state.bossActive = false; }
    }

    for (let i = state.coins.length - 1; i >= 0; i--) {
        const c = state.coins[i];
        c.position.z += effectiveSpeed * dt;
        c.rotation.y += dt * 4;
        if (c.position.z > 12) { scene.remove(c); state.coins.splice(i, 1); }
    }
    for (let i = state.bonuses.length - 1; i >= 0; i--) {
        const b = state.bonuses[i];
        b.position.z += effectiveSpeed * dt;
        b.rotation.y += dt * 3;
        b.rotation.x += dt * 2;
        if (b.position.z > 12) { scene.remove(b); state.bonuses.splice(i, 1); }
    }

    updateParticles(dt);

    state.spawnTimer += dt;
    if (state.spawnTimer > 0.55) { state.spawnTimer = 0; if (Math.random() < .75) spawnObstacle(); }
    state.coinTimer += dt;
    if (state.coinTimer > 1.0) { state.coinTimer = 0; spawnCoin(); }
    state.bonusTimer += dt;
    if (state.bonusTimer > 8) { state.bonusTimer = 0; if (Math.random() < .55) spawnBonus(); }

    state.baseSpeed = Math.min(state.baseSpeed + 0.02 * dt * 60, 22);

    checkCollisions();
    updateWeather(dt);

    camera.position.x += (state.playerX * 0.4 - camera.position.x) * 0.08;
    camera.lookAt(state.playerX * 0.4, 1.8, -5);

    state.lastHudUpdate += dt;
    if (state.lastHudUpdate > 0.1) {
        state.lastHudUpdate = 0;
        updateHUD();
    }
}

function animate(now) {
    requestAnimationFrame(animate);
    let dt = (now - lastTime) / 1000;
    lastTime = now;
    if (dt > 0.25) dt = 0.25;
    accumulator += dt;
    let steps = 0;
    while (accumulator >= FIXED_DT && steps < 6) {
        update(FIXED_DT);
        accumulator -= FIXED_DT;
        steps++;
    }
    if (!state.paused) renderer.render(scene, camera);
}

