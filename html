const ACHIEVEMENTS = [
    { id:'first', icon:'🌟', title:'Первый шаг', desc:'Сыграйте первую игру', check:s=>(s.gamesPlayed||0)>=1 },
    { id:'score50', icon:'🥉', title:'Новичок', desc:'50 очков', check:s=>(s.best||0)>=50 },
