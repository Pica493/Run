<script>
'use strict';
document.addEventListener('contextmenu', e => e.preventDefault());

const storage = {
    get(k, f) { try { const v = localStorage.getItem(k); return v === null ? f : v; } catch(e) { return f; } },
    set(k, v) { try { localStorage.setItem(k, v); } catch(e) {} }
};

// ================ ЗВУК ================
class AudioManager {
    constructor() {
        this.ctx = null; this.musicGain = null; this.sfxGain = null;
        this.musicEnabled = storage.get('r3d_music', 'true') !== 'false';
        this.soundEnabled = storage.get('r3d_sound', 'true') !== 'false';
        this.musicVolume = 0.25; this.soundVolume = 0.5;
        this.started = false; this.musicStep = 0;
        this.suspended = false; this.forceMute = false;
        this.pattern = [261.63, 329.63, 392.00, 329.63, 293.66, 392.00, 440.00, 392.00];
    }
    ensureContext() {
        if (!this.ctx) {
            try {
                const AC = window.AudioContext || window.webkitAudioContext;
                if (!AC) return false;
                this.ctx = new AC();
                this.musicGain = this.ctx.createGain();
                this.musicGain.gain.value = 0;
                this.musicGain.connect(this.ctx.destination);
                this.sfxGain = this.ctx.createGain();
                this.sfxGain.gain.value = 0;
                this.sfxGain.connect(this.ctx.destination);
            } catch(e) { return false; }
        }
        return true;
    }
    start() {
        if (!this.ensureContext()) return;
        if (this.ctx.state === 'suspended') this.ctx.resume().catch(()=>{});
        if (!this.started) { this.started = true; this._loop(); }
        this._applyVolumes();
    }
    _applyVolumes() {
        if (!this.musicGain || !this.sfxGain) return;
        const musicOn = this.musicEnabled && !this.suspended && !this.forceMute;
        const sfxOn = this.soundEnabled && !this.suspended && !this.forceMute;
        this.musicGain.gain.value = musicOn ? this.musicVolume : 0;
        this.sfxGain.gain.value = sfxOn ? this.soundVolume : 0;
    }
    suspend() {
        this.suspended = true;
        this._applyVolumes();
        if (this.ctx && this.ctx.state === 'running') try { this.ctx.suspend(); } catch(e) {}
    }
    resume() {
        this.suspended = false;
        if (this.ctx && this.ctx.state === 'suspended') try { this.ctx.resume(); } catch(e) {}
        this._applyVolumes();
    }
    setForceMute(on) { this.forceMute = on; this._applyVolumes(); }
    _tone(f, d, t, v, delay, gn) {
        if (!this.ctx || this.ctx.state !== 'running' || this.suspended || this.forceMute) return;
        if (!this.soundEnabled && gn !== this.musicGain) return;
        if (!this.musicEnabled && gn === this.musicGain) return;
        try {
            const t0 = this.ctx.currentTime + (delay || 0);
            const osc = this.ctx.createOscillator();
            const g = this.ctx.createGain();
            osc.type = t || 'sine';
            osc.frequency.setValueAtTime(f, t0);
            g.gain.setValueAtTime(0.0001, t0);
            g.gain.linearRampToValueAtTime(v, t0 + 0.015);
            g.gain.exponentialRampToValueAtTime(0.0001, t0 + d);
            osc.connect(g).connect(gn || this.sfxGain);
            osc.start(t0); osc.stop(t0 + d + 0.05);
        } catch(e) {}
    }
    sfxJump() { this._tone(420, .12, 'triangle', .35); this._tone(680, .1, 'triangle', .22, .05); }
    sfxCoin() { this._tone(1200, .08, 'sine', .3); this._tone(1600, .1, 'sine', .22, .04); }
    sfxHit() { this._tone(180, .3, 'sawtooth', .35); this._tone(90, .4, 'sawtooth', .28, .1); }
    sfxZone() { [523, 659, 784].forEach((f, i) => this._tone(f, .2, 'triangle', .3, i * .08)); }
    sfxClick() { this._tone(600, .06, 'square', .22); }
    sfxBonus() { [880, 1100, 1320].forEach((f, i) => this._tone(f, .15, 'sine', .3, i * .06)); }
    sfxAch() { [660, 880, 1100, 1320].forEach((f, i) => this._tone(f, .18, 'triangle', .28, i * .1)); }
    sfxWheel() { [440, 550, 660, 880, 1100].forEach((f, i) => this._tone(f, .12, 'square', .22, i * .1)); }
    _loop() {
        const d = 0.42;
        const loop = () => {
            if (this.started && this.musicEnabled && !this.suspended && !this.forceMute && this.ctx && this.ctx.state === 'running') {
                const n = this.pattern[this.musicStep % this.pattern.length];
                this._tone(n, d * .85, 'sine', .14, 0, this.musicGain);
                if (this.musicStep % 4 === 0) this._tone(130.81, d * 1.5, 'triangle', .11, 0, this.musicGain);
                this.musicStep++;
            }
            setTimeout(loop, d * 1000);
        };
        loop();
    }
    setSoundEnabled(on) { this.soundEnabled = on; storage.set('r3d_sound', String(on)); this._applyVolumes(); }
    setMusicEnabled(on) { this.musicEnabled = on; storage.set('r3d_music', String(on)); this._applyVolumes(); }
}
const audio = new AudioManager();

// ================ ДАННЫЕ ================
const SKINS = [
    { id:'default', name:'Строитель', color:0x3a6ea5, price:0, bonus:'none' },
    { id:'sprinter', name:'Спринтер', color:0x3498db, price:30, bonus:'speed' },
