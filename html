    audio.resume();
    if (ysdk && ysdk.features && ysdk.features.GameplayAPI) {
        try { ysdk.features.GameplayAPI.start(); } catch(e) {}
    }
}

function togglePause() {
    if (!state.playing || state.over) return;
    state.paused = !state.paused;
    document.getElementById('pauseScreen').classList.toggle('active', state.paused);
    if (state.paused) { hideHUD(); audio.suspend(); }
    else { showHUD(); audio.resume(); }
    if (ysdk && ysdk.features && ysdk.features.GameplayAPI) {
        try { state.paused ? ysdk.features.GameplayAPI.stop() : ysdk.features.GameplayAPI.start(); } catch(e) {}
    }
}

function goToMenu() {
    state.playing = false; state.paused = false; state.over = false;
    document.querySelectorAll('.overlay').forEach(o => o.classList.remove('active'));
    document.getElementById('startScreen').classList.add('active');
    hideHUD();
    updateMenuCoins();
    clearWorld();
    setWeather('clear');
    document.getElementById('quickCoins').classList.remove('hidden-q');
    if (ysdk && ysdk.features && ysdk.features.GameplayAPI) {
        try { ysdk.features.GameplayAPI.stop(); } catch(e) {}
    }
}

// ================ МАГАЗИН ================
function renderShop() {
    const grid = document.getElementById('skinGrid');
    grid.innerHTML = '';
    SKINS.forEach(skin => {
        const owned = save.skins.includes(skin.id);
        const selected = save.currentSkin === skin.id;
        const div = document.createElement('div');
        div.className = 'card' + (selected ? ' selected' : '') + (owned ? ' owned' : '');
        const hex = '#' + skin.color.toString(16).padStart(6, '0');
        let bonusText = '';
        if (skin.bonus === 'speed') bonusText = ' ⚡+5%';
        else if (skin.bonus === 'coins') bonusText = ' 💰+10%';
        else if (skin.bonus === 'coins2') bonusText = ' 💰+25%';
        else if (skin.bonus === 'jump') bonusText = ' 🦘+15%';
        div.innerHTML = `
            <div class="swatch" style="background:${hex}"></div>
            <div class="name">${skin.name}${bonusText}</div>
            <div class="price">${owned ? (selected ? '✓' : 'Выбрать') : '🪙 ' + skin.price}</div>
        `;
        div.addEventListener('click', () => {
            audio.sfxClick();
            if (owned) {
                save.currentSkin = skin.id; saveSave(); debouncedCloudSave(); renderShop(); checkAchievements();
            } else if (save.coins >= skin.price) {
                save.coins -= skin.price;
                save.skins.push(skin.id);
                save.currentSkin = skin.id;
                saveSave(); debouncedCloudSave(); renderShop(); updateMenuCoins(); checkAchievements();
            } else showToast('Недостаточно монет!');
        });
        grid.appendChild(div);
    });
}

// ================ РЕЖИМЫ ================
function renderModes() {
    const grid = document.getElementById('modesGrid');
    grid.innerHTML = '';
    MODES.forEach(m => {
        const div = document.createElement('div');
        div.className = 'card' + (state.mode === m.id ? ' selected' : '');
        div.innerHTML = `
            <div style="font-size:32px;margin-bottom:6px">${m.icon}</div>
            <div class="name" style="font-size:14px;font-weight:bold;color:#fff">${m.name}</div>
            <div style="font-size:11px;color:#aaa;margin:4px 0">${m.desc}</div>
        `;
        div.addEventListener('click', () => {
            audio.sfxClick();
            state.mode = m.id;
            renderModes();
            showToast('Режим: ' + m.name);
        });
        grid.appendChild(div);
    });
}

// ================ ДОСТИЖЕНИЯ UI ================
function renderAchievements() {
    const list = document.getElementById('achievementsList');
    list.innerHTML = '';
    let unlocked = 0;
    ACHIEVEMENTS.forEach(a => {
        const isU = save.achievements.includes(a.id);
        if (isU) unlocked++;
        const div = document.createElement('div');
        div.className = 'achievement-card' + (isU ? ' unlocked' : '');
        div.innerHTML = `
            <span class="icon">${isU ? a.icon : '🔒'}</span>
            <div class="text">
                <div class="title">${a.title}</div>
                <div class="desc">${a.desc}</div>
            </div>
        `;
        list.appendChild(div);
    });
    document.getElementById('achProgress').textContent = unlocked + '/' + ACHIEVEMENTS.length;
}

// ================ ЛИДЕРБОРД ================
async function renderLeaderboard() {
    const list = document.getElementById('leaderboardList');
    list.innerHTML = '<div style="color:#888;padding:20px;text-align:center">Загрузка...</div>';
    if (!ysdk || !ysdk.leaderboards) {
        list.innerHTML = `
            <div class="leaderboard-row me">
                <span class="rank">1</span><span class="nick">Вы</span><span class="score">${save.best}</span>
            </div>
            <div style="color:#888;margin-top:12px;font-size:13px;text-align:center">Полный лидерборд доступен в Яндекс Играх</div>
        `;
        return;
    }
    try {
        const result = await ysdk.leaderboards.getLeaderboardEntries('best_score', {
            quantityTop: 10, includeUser: true, quantityAround: 3,
        });
        list.innerHTML = '';
        if (!result || !result.entries || !result.entries.length) {
            list.innerHTML = '<div style="color:#888;padding:20px">Пока нет результатов</div>';
            return;
        }
        const myId = ysdkPlayer ? ysdkPlayer.uniqueID : null;
        result.entries.forEach(entry => {
            const playerId = entry.player ? entry.player.uniqueID : null;
            const isMe = myId && playerId === myId;
            const div = document.createElement('div');
            div.className = 'leaderboard-row' + (isMe ? ' me' : '');
            div.innerHTML = `
                <span class="rank">${entry.rank}</span>
                <span class="nick">${(entry.player && entry.player.publicName) || 'Аноним'}</span>
                <span class="score">${entry.score}</span>
            `;
            list.appendChild(div);
        });
    } catch (e) {
        console.warn('LB error', e);
        list.innerHTML = '<div style="color:#888;padding:20px">Не удалось загрузить</div>';
    }
}

// ================ КНОПКИ ================
document.getElementById('startBtn').onclick = () => { audio.start(); audio.sfxClick(); startGame(); };
document.getElementById('restartBtn').onclick = () => { audio.sfxClick(); startGame(); };
document.getElementById('menuBtn').onclick = () => { audio.sfxClick(); goToMenu(); };
document.getElementById('pauseMenuBtn').onclick = () => { audio.sfxClick(); goToMenu(); };
document.getElementById('resumeBtn').onclick = () => { audio.sfxClick(); togglePause(); };
document.getElementById('pauseBtn').onclick = () => { audio.sfxClick(); togglePause(); };

document.getElementById('shopBtn').onclick = () => { audio.sfxClick(); renderShop(); switchScreen('startScreen', 'shopScreen'); };
document.getElementById('closeShopBtn').onclick = () => { audio.sfxClick(); switchScreen('shopScreen', 'startScreen'); updateMenuCoins(); };

document.getElementById('achievementsBtn').onclick = () => { audio.sfxClick(); renderAchievements(); switchScreen('startScreen', 'achievementsScreen'); };
document.getElementById('closeAchBtn').onclick = () => { audio.sfxClick(); switchScreen('achievementsScreen', 'startScreen'); };

document.getElementById('leaderboardBtn').onclick = () => { audio.sfxClick(); renderLeaderboard(); switchScreen('startScreen', 'leaderboardScreen'); };
document.getElementById('closeLbBtn').onclick = () => { audio.sfxClick(); switchScreen('leaderboardScreen', 'startScreen'); };

document.getElementById('modesBtn').onclick = () => { audio.sfxClick(); renderModes(); switchScreen('startScreen', 'modesScreen'); };
document.getElementById('closeModesBtn').onclick = () => { audio.sfxClick(); switchScreen('modesScreen', 'startScreen'); };

document.getElementById('dailyBtn').onclick = () => { audio.sfxClick(); claimDaily(); };
document.getElementById('missionsBtn').onclick = () => { audio.sfxClick(); renderMissions(); switchScreen('startScreen', 'missionsScreen'); };
document.getElementById('closeMissionsBtn').onclick = () => { audio.sfxClick(); switchScreen('missionsScreen', 'startScreen'); };

document.getElementById('wheelBtn').onclick = () => { audio.sfxClick(); drawWheel(); updateWheelUI(); switchScreen('startScreen', 'wheelScreen'); };
document.getElementById('closeWheelBtn').onclick = () => { audio.sfxClick(); switchScreen('wheelScreen', 'startScreen'); updateMenuCoins(); };
document.getElementById('spinBtn').onclick = () => { audio.sfxClick(); spinWheel(); };

document.getElementById('reviveBtn').onclick = () => {
    audio.sfxClick();
    if (state.reviveUsed) return;
    showRewardedAd(() => revivePlayer(), () => showToast('Реклама недоступна'));
};
document.getElementById('doubleCoinsBtn').onclick = () => {
    audio.sfxClick();
    if (state.doubleCoinsUsed || state.coinsThisRun === 0) return;
    showRewardedAd(() => {
        state.doubleCoinsUsed = true;
        save.coins += state.coinsThisRun;
        save.totalCoins += state.coinsThisRun;
        saveSave(); debouncedCloudSave(); updateHUD(); updateMenuCoins();
        document.getElementById('doubleCoinsBtn').style.display = 'none';
        showToast('Монеты удвоены!');
        checkAchievements();
    }, () => showToast('Реклама недоступна'));
};

// ================ ЗАПУСК ================
applySkin(save.currentSkin);
applyZone(0);
updateMenuCoins();
updateHUD();
generateMissions();
initSDK();
requestAnimationFrame(animate);
</script>
