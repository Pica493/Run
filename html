    { id:'score200', icon:'🥇', title:'Мастер', desc:'200 очков', check:s=>(s.best||0)>=200 },
    { id:'score500', icon:'👑', title:'Легенда', desc:'500 очков', check:s=>(s.best||0)>=500 },
    { id:'coins100', icon:'💰', title:'Кладоискатель', desc:'100 монет всего', check:s=>(s.totalCoins||0)>=100 },
    { id:'coins500', icon:'💎', title:'Богач', desc:'500 монет всего', check:s=>(s.totalCoins||0)>=500 },
    { id:'zone5', icon:'🌍', title:'Путешественник', desc:'Все 5 зон', check:s=>(s.zonesVisited||0)>=5 },
