let weatherGroup = null;
let weatherType = 'clear';
let weatherTimer = 0;
const _weatherGeoRain = new THREE.BoxGeometry(.05, .5, .05);
const _weatherGeoSnow = new THREE.SphereGeometry(.08, 6, 6);
const _weatherGeoLeaf = new THREE.BoxGeometry(.2, .05, .2);
function disposeWeather() {
    if (!weatherGroup) return;
    weatherGroup.children.forEach(p => {
        if (p.material) p.material.dispose();
    });
    scene.remove(weatherGroup);
    weatherGroup = null;
}
function setWeather(type) {
    if (type === weatherType && weatherGroup) return;
    weatherType = type;
    disposeWeather();
    if (type === 'clear') return;
    weatherGroup = new THREE.Group();
    const count = type === 'rain' ? 80 : type === 'snow' ? 60 : 30;
    for (let i = 0; i < count; i++) {
        let geo, mat;
        if (type === 'rain') {
            geo = _weatherGeoRain;
            mat = new THREE.MeshBasicMaterial({ color:0x88bbff, transparent:true, opacity:.6 });
        } else if (type === 'snow') {
            geo = _weatherGeoSnow;
            mat = new THREE.MeshBasicMaterial({ color:0xffffff, transparent:true, opacity:.85 });
        } else {
            geo = _weatherGeoLeaf;
            mat = new THREE.MeshBasicMaterial({ color:[0xff8c42, 0xc0392b, 0xf1c40f][i % 3], transparent:true, opacity:.9 });
        }
        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.set(-12 + Math.random() * 24, 5 + Math.random() * 20, -Math.random() * 90);
        mesh.userData.speed = type === 'rain' ? 30 + Math.random() * 20 : type === 'snow' ? 4 + Math.random() * 4 : 6 + Math.random() * 4;
        mesh.userData.sway = Math.random() * Math.PI * 2;
        weatherGroup.add(mesh);
    }
    scene.add(weatherGroup);
}
function updateWeather(dt) {
    weatherTimer += dt;
    if (weatherTimer > 25) {
        weatherTimer = 0;
        const types = ['clear', 'rain', 'snow', 'leaves'];
        setWeather(types[Math.floor(Math.random() * types.length)]);
    }
    if (!weatherGroup) return;
    weatherGroup.children.forEach(p => {
        p.position.z += (state.baseSpeed * 0.5) * dt;
        p.position.y -= p.userData.speed * dt;
        if (weatherType === 'leaves' || weatherType === 'snow') {
            p.userData.sway += dt * 2;
            p.position.x += Math.sin(p.userData.sway) * dt * 3;
        }
        if (p.position.y < 0 || p.position.z > 15) {
            p.position.y = 15 + Math.random() * 10;
            p.position.x = -12 + Math.random() * 24;
            p.position.z = -Math.random() * 90;
        }
    });
}

