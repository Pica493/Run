    { id:'allSkins', icon:'🎨', title:'Коллекционер', desc:'Все скины', check:s=>(s.skins||[]).length>=SKINS.length },
    { id:'daily7', icon:'🔥', title:'Постоянный', desc:'7 дней подряд', check:s=>(s.dailyStreak||0)>=7 },
    { id:'wheel3', icon:'🎡', title:'Везунчик', desc:'3 прокрута колеса', check:s=>(s.wheelSpins||0)>=3 },
    { id:'boss1', icon:'⚔️', title:'Боссобоец', desc:'Убить босса', check:s=>(s.bossesKilled||0)>=1 },
];

const MODES = [
    { id:'endless', name:'Endless', desc:'Классический бесконечный забег', icon:'♾️', speedMul:1, coinMul:1, timeLimit:0 },
    { id:'time', name:'Time Attack', desc:'60 секунд — максимум очков', icon:'⏱', speedMul:1.1, coinMul:1.5, timeLimit:60 },
    { id:'hard', name:'Hard Mode', desc:'Скорость x1.8, монеты x3', icon:'🔥', speedMul:1.8, coinMul:3, timeLimit:0 },
];

function loadSave() {
    try {
        const s = JSON.parse(storage.get('r3d_save', 'null')) || {};
        return {
            best: +s.best || 0, coins: +s.coins || 0,
            skins: Array.isArray(s.skins) && s.skins.length ? s.skins : ['default'],
            currentSkin: s.currentSkin || 'default',
            achievements: Array.isArray(s.achievements) ? s.achievements : [],
            gamesPlayed: +s.gamesPlayed || 0,
            totalCoins: +s.totalCoins || 0,
            zonesVisited: +s.zonesVisited || 0,
            zonesVisitedSet: Array.isArray(s.zonesVisitedSet) ? s.zonesVisitedSet : [],
            flawless50: !!s.flawless50,
            noAds: !!s.noAds,
            lastDaily: s.lastDaily || null,
            dailyStreak: +s.dailyStreak || 0,
            lastWheel: s.lastWheel || null,
            wheelSpins: +s.wheelSpins || 0,
            missionsDate: s.missionsDate || null,
            missionsProgress: s.missionsProgress || null,
            bossesKilled: +s.bossesKilled || 0,
        };
    } catch(e) {
        return { best:0, coins:0, skins:['default'], currentSkin:'default',
                 achievements:[], gamesPlayed:0, totalCoins:0, zonesVisited:0,
                 zonesVisitedSet:[], flawless50:false, noAds:false,
                 lastDaily:null, dailyStreak:0, lastWheel:null, wheelSpins:0,
                 missionsDate:null, missionsProgress:null, bossesKilled:0 };
    }
}
function saveSave() { storage.set('r3d_save', JSON.stringify(save)); }
let save = loadSave();

// ================ SDK ================
let ysdk = null, ysdkPlayer = null;
let cloudSaveTimeout = null;
let localStorageSaveTimeout = null;

function debouncedCloudSave() {
    if (cloudSaveTimeout) clearTimeout(cloudSaveTimeout);
    cloudSaveTimeout = setTimeout(() => pushCloudSave(), 800);
}
function debouncedLocalSave() {
    if (localStorageSaveTimeout) clearTimeout(localStorageSaveTimeout);
    localStorageSaveTimeout = setTimeout(() => saveSave(), 1000);
}
async function initSDK() {
    if (!window.YaGames) return;
    try {
        ysdk = await YaGames.init();
        window.ysdk = ysdk;
        try { ysdk.features.LoadingAPI.ready(); } catch(e) {}
        const lang = (ysdk.environment && ysdk.environment.i18n && ysdk.environment.i18n.lang) || 'ru';
        applyLanguage(lang);
        try {
            ysdkPlayer = await ysdk.getPlayer({ scopes: false });
            const d = await ysdkPlayer.getData(['save']);
            if (d && d.save) {
                const c = d.save;
                save.best = Math.max(save.best, +c.best || 0);
                save.coins = Math.max(save.coins, +c.coins || 0);
                save.gamesPlayed = Math.max(save.gamesPlayed, +c.gamesPlayed || 0);
                save.totalCoins = Math.max(save.totalCoins, +c.totalCoins || 0);
                save.dailyStreak = Math.max(save.dailyStreak, +c.dailyStreak || 0);
                save.wheelSpins = Math.max(save.wheelSpins, +c.wheelSpins || 0);
                save.bossesKilled = Math.max(save.bossesKilled, +c.bossesKilled || 0);
                if (Array.isArray(c.skins)) save.skins = Array.from(new Set([...save.skins, ...c.skins]));
                if (Array.isArray(c.achievements)) save.achievements = Array.from(new Set([...save.achievements, ...c.achievements]));
                saveSave();
            }
            await pushCloudSave();
        } catch(e) { console.warn('Cloud error:', e); }
    } catch(e) { console.warn('SDK init failed:', e); applyLanguage('ru'); }
}
async function pushCloudSave() {
    if (!ysdkPlayer) return;
    try { await ysdkPlayer.setData({ save }, false); } catch(e) {}
}
function showRewardedAd(onReward, onFail) {
    audio.setForceMute(true);
    hideHUD();
    document.querySelectorAll('#gameOverScreen button').forEach(b => b.disabled = true);
    const cleanup = () => {
        audio.setForceMute(false);
        document.querySelectorAll('#gameOverScreen button').forEach(b => b.disabled = false);
        if (state.playing && !state.paused && !state.over) showHUD();
    };
    if (ysdk && ysdk.adv && ysdk.adv.showRewardedVideo) {
        try {
            ysdk.adv.showRewardedVideo({
                callbacks: {
                    onOpen: () => {},
                    onRewarded: () => { try { onReward && onReward(); } catch(e){console.warn(e);} },
                    onClose: () => { cleanup(); },
                    onError: (e) => { console.warn('Ad error', e); cleanup(); onFail && onFail(); }
                }
            });
        } catch(e) { cleanup(); onFail && onFail(); }
    } else {
        setTimeout(() => { cleanup(); onReward && onReward(); }, 300);
    }
}

