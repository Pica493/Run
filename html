}

// ================ КОЛЕСО ================
const WHEEL_PRIZES = [
    { label:'10', value:10, color:'#e94560' },
    { label:'50', value:50, color:'#4ce0ff' },
    { label:'5', value:5, color:'#2a2a4a' },
    { label:'100', value:100, color:'#ffd700' },
    { label:'20', value:20, color:'#27ae60' },
    { label:'200', value:200, color:'#ff9f4a' },
    { label:'15', value:15, color:'#8e44ad' },
    { label:'75', value:75, color:'#1abc9c' },
];
let wheelRotation = 0;
let wheelSpinning = false;
function drawWheel() {
    const wc = document.getElementById('wheelCanvas');
    if (!wc) return;
    const ctx = wc.getContext('2d');
    const cx = wc.width / 2, cy = wc.height / 2, r = cx - 5;
    const arc = Math.PI * 2 / WHEEL_PRIZES.length;
    ctx.clearRect(0, 0, wc.width, wc.height);
    WHEEL_PRIZES.forEach((p, i) => {
        const a0 = i * arc + wheelRotation;
        const a1 = a0 + arc;
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, r, a0, a1);
        ctx.closePath();
        ctx.fillStyle = p.color;
        ctx.fill();
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(a0 + arc / 2);
        ctx.textAlign = 'right';
        ctx.fillStyle = '#fff';
        ctx.font = 'bold 20px monospace';
        ctx.fillText(p.label, r - 15, 7);
        ctx.restore();
    });
    ctx.beginPath();
    ctx.arc(cx, cy, 25, 0, Math.PI * 2);
    ctx.fillStyle = '#1a1a2e';
    ctx.fill();
    ctx.strokeStyle = '#ffd700';
    ctx.lineWidth = 3;
    ctx.stroke();
}
function updateWheelUI() {
    const today = getTodayKey();
    const canFree = save.lastWheel !== today;
    const spinBtn = document.getElementById('spinBtn');
    const status = document.getElementById('wheelStatus');
    if (canFree) {
        spinBtn.textContent = '🎯 КРУТИТЬ (бесплатно)';
        spinBtn.disabled = false;
        status.textContent = 'Один бесплатный прокрут в день';
    } else {
        spinBtn.textContent = '💰 КРУТИТЬ за 30 монет';
        spinBtn.disabled = save.coins < 30;
        status.textContent = 'Бесплатный прокрут использован';
    }
}
function spinWheel() {
    if (wheelSpinning) return;
    const today = getTodayKey();
    const canFree = save.lastWheel !== today;
    if (!canFree) {
        if (save.coins < 30) { showToast('Недостаточно монет'); return; }
        save.coins -= 30;
        updateMenuCoins();
    }
    wheelSpinning = true;
    document.getElementById('spinBtn').disabled = true;
    document.getElementById('wheelPrize').textContent = '';
    audio.sfxWheel();
    const targetRotation = wheelRotation + Math.PI * 2 * (5 + Math.random() * 3) + Math.random() * Math.PI * 2;
    const startRot = wheelRotation;
    const startTime = performance.now();
    const duration = 3500;
    function spinAnim(now) {
        const t = Math.min(1, (now - startTime) / duration);
        const ease = 1 - Math.pow(1 - t, 3);
        wheelRotation = startRot + (targetRotation - startRot) * ease;
        drawWheel();
        if (t < 1) requestAnimationFrame(spinAnim);
        else {
            wheelSpinning = false;
            wheelRotation = wheelRotation % (Math.PI * 2);
            save.lastWheel = today;
            save.wheelSpins = (save.wheelSpins || 0) + 1;
            const arc = Math.PI * 2 / WHEEL_PRIZES.length;
            const norm = ((wheelRotation % (Math.PI*2)) + Math.PI*2) % (Math.PI*2);
            const pointerAngle = (Math.PI * 1.5 - norm + Math.PI * 2) % (Math.PI * 2);
            const idx = Math.floor(pointerAngle / arc) % WHEEL_PRIZES.length;
            const prize = WHEEL_PRIZES[idx];
            save.coins += prize.value;
            save.totalCoins += prize.value;
            saveSave(); debouncedCloudSave();
            updateMenuCoins();
            document.getElementById('wheelPrize').textContent = '🎉 +' + prize.value + ' 🪙';
            audio.sfxAch();
            updateWheelUI();
            checkAchievements();
        }
    }
    requestAnimationFrame(spinAnim);
}

