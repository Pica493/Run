// ================ МИССИИ ================
function getTodayKey() { return new Date().toISOString().slice(0,10); }
function generateMissions() {
    const today = getTodayKey();
    if (save.missionsDate === today && save.missionsProgress) return;
    const allMissions = [
        { id:'coins', title:'Собери 30 монет', target:30, reward:15 },
        { id:'score', title:'Пробеги 50 очков', target:50, reward:15 },
        { id:'bonus', title:'Используй 3 бонуса', target:3, reward:20 },
        { id:'games', title:'Сыграй 3 игры', target:3, reward:15 },
    ];
    const shuffled = allMissions.slice().sort(() => Math.random() - .5).slice(0,3);
    save.missionsDate = today;
    save.missionsProgress = {};
    shuffled.forEach(m => {
        save.missionsProgress[m.id] = { current:0, target:m.target, reward:m.reward, title:m.title, claimed:false };
    });
    saveSave();
}
function updateMissions(key, amount) {
    if (!save.missionsProgress) return;
    const p = save.missionsProgress[key];
    if (p && !p.claimed && p.current < p.target) {
        p.current = Math.min(p.target, p.current + amount);
        if (p.current >= p.target) {
            p.claimed = true;
            save.coins += p.reward;
            save.totalCoins += p.reward;
            debouncedLocalSave(); debouncedCloudSave();
            showToast('✅ Миссия: ' + p.title + ' (+' + p.reward + '🪙)');
            updateMenuCoins();
            checkAchievements();
        } else {
            debouncedLocalSave();
        }
    }
}
function renderMissions() {
    generateMissions();
    const list = document.getElementById('missionsList');
    list.innerHTML = '';
    Object.keys(save.missionsProgress || {}).forEach(key => {
        const m = save.missionsProgress[key];
        const div = document.createElement('div');
        div.className = 'mission-item' + (m.claimed ? ' done' : '');
        div.innerHTML = `
            <div style="flex:1;min-width:0">
                <div style="font-size:14px;font-weight:bold;color:#fff">${m.title}</div>
                <div class="progress">${m.current}/${m.target}</div>
            </div>
            <div class="reward">${m.claimed ? '✓' : '+' + m.reward + '🪙'}</div>
        `;
        list.appendChild(div);
    });
}

