#hud .timer{font-size:18px;color:#4ce0ff;font-weight:bold}
@keyframes pulse{from{opacity:.7}to{opacity:1}}
.overlay{position:fixed;inset:0;display:none;flex-direction:column;align-items:center;color:#fff;z-index:20;text-align:center;padding:20px 16px;background:rgba(10,10,30,.95);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);overflow-y:auto;-webkit-overflow-scrolling:touch;touch-action:pan-y}
.overlay.active{display:flex}
.overlay::before,.overlay::after{content:'';flex:1 0 auto;min-height:10px}
.overlay > *{flex-shrink:0}
.overlay h1{font-size:30px;color:#e94560;margin-bottom:10px;text-shadow:0 0 20px #e94560}
.overlay h2{font-size:20px;color:#ffd700;margin-bottom:10px}
.overlay p{font-size:15px;margin:3px 0;color:#cfd6ff}
.overlay p .accent{color:#ffd700;font-weight:bold}
.overlay button{margin-top:8px;padding:12px 26px;font-size:16px;font-weight:bold;background:#ffd700;color:#1a1a2e;border:none;border-radius:30px;cursor:pointer;box-shadow:0 4px 0 #b8960f;font-family:inherit;transition:.05s linear;white-space:nowrap}
.overlay button:active{transform:translateY(4px);box-shadow:none}
.overlay button.secondary{background:#2a2a4a;color:#fff;box-shadow:0 4px 0 #14142a}
