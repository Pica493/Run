    ctx.fillStyle = '#2c3e50';
    roundRect(ctx, cx - 6*s, baseY - 22*s, 4*s, 12*s, 2*s); ctx.fill();
    roundRect(ctx, cx + 2*s, baseY - 22*s, 4*s, 12*s, 2*s); ctx.fill();
    ctx.fillStyle = '#1a1a1a';
    ctx.beginPath(); ctx.ellipse(cx - 4*s, baseY - 10*s, 5*s, 3*s, 0, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(cx + 4*s, baseY - 10*s, 5*s, 3*s, 0, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = shirt;
    roundRect(ctx, cx - 8*s, baseY - 40*s, 16*s, 20*s, 5*s); ctx.fill();
    ctx.fillStyle = skinCol;
    roundRect(ctx, cx - 12*s, baseY - 38*s, 4*s, 14*s, 2*s); ctx.fill();
    roundRect(ctx, cx + 8*s, baseY - 38*s, 4*s, 14*s, 2*s); ctx.fill();
