    <symbol id="i-jetpack" viewBox="0 0 24 24"><rect x="8" y="4" width="8" height="12" rx="2" fill="currentColor"/><circle cx="12" cy="7" r="1.5" fill="#fff"/><path d="M6 18 L8 22 M18 18 L16 22" stroke="currentColor" stroke-width="2"/><path d="M10 20 L11 23 M14 20 L13 23" stroke="#ff9f4a" stroke-width="2"/></symbol>
