function buildSmoothPlayerMesh(skinDef) {
    const g = new THREE.Group();
    const matShirt = new THREE.MeshStandardMaterial({ color:skinDef.shirt, roughness:.7, metalness:.05 });
    const matSkin  = new THREE.MeshStandardMaterial({ color:0xf5d0b0, roughness:.75 });
    const matPants = new THREE.MeshStandardMaterial({ color:0x2c3e50, roughness:.85 });
    const matBlack = new THREE.MeshStandardMaterial({ color:0x1a1a1a, roughness:.9 });
    const body = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.35, 1.4, 16), matShirt);
    body.rotation.z = Math.PI / 2; body.position.y = 0.35; body.castShadow = true;
    g.add(body);
    const capF = new THREE.Mesh(new THREE.SphereGeometry(0.35, 16, 12), matShirt);
    capF.position.set(0.7, 0.35, 0); capF.castShadow = true;
    const capB = capF.clone(); capB.position.x = -0.7;
    g.add(capF); g.add(capB);
    const head = new THREE.Mesh(new THREE.SphereGeometry(0.32, 20, 16), matSkin);
    head.position.set(1.0, 0.4, 0); head.castShadow = true;
    g.add(head);
    g.add((() => { const c = new THREE.Mesh(new THREE.SphereGeometry(0.34, 20, 12, 0, Math.PI*2, 0, Math.PI/2), matShirt); c.position.set(1.0, 0.4, 0); return c; })());
    const legL = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.11, 0.6, 10), matPants);
    legL.rotation.z = Math.PI / 2; legL.position.set(-1.2, 0.25, 0.15); legL.castShadow = true;
    g.add(legL);
    const legR = legL.clone(); legR.position.z = -0.15; g.add(legR);
    const footL = new THREE.Mesh(new THREE.SphereGeometry(0.13, 12, 10), matBlack);
    footL.position.set(-1.5, 0.15, 0.15); g.add(footL);
    const footR = footL.clone(); footR.position.z = -0.15; g.add(footR);
    const armL = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.09, 0.5, 10), matSkin);
    armL.rotation.z = Math.PI / 2.3; armL.position.set(0.5, 0.4, 0.35); armL.castShadow = true;
    g.add(armL);
    const armR = armL.clone(); armR.rotation.z = Math.PI / 1.7; armR.position.z = -0.35;
    g.add(armR);
    return g;
}

function buildSmoothBoss() {
