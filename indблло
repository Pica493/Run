    leafG: new THREE.MeshBasicMaterial({ color:0xc0392b, transparent:true, opacity:.9 }),
};
const WEATHER_LEAF_MATS = [WEATHER_MATS.leafR, WEATHER_MATS.leafY, WEATHER_MATS.leafG];

function disposeWeather() {
    if (!weatherGroup) return;
    scene.remove(weatherGroup); weatherGroup = null;
}
function setWeather(type) {
    if (type === weatherType) return;         // РЕЛИЗ: правильно для clear
    weatherType = type; disposeWeather();
    if (type === 'clear') return;
    weatherGroup = new THREE.Group();
    const count = type === 'rain' ? 80 : type === 'snow' ? 60 : 30;
    for (let i = 0; i < count; i++) {
        let geo, mat;
        if (type === 'rain') { geo = _wGeoRain; mat = WEATHER_MATS.rain; }
        else if (type === 'snow') { geo = _wGeoSnow; mat = WEATHER_MATS.snow; }
        else { geo = _wGeoLeaf; mat = WEATHER_LEAF_MATS[i % 3]; }   // РЕЛИЗ: fix
        const m = new THREE.Mesh(geo, mat);
        m.position.set(-14 + Math.random()*28, 5 + Math.random()*20, -Math.random()*100);
        m.userData.speed = type === 'rain' ? 30 + Math.random()*20 : type === 'snow' ? 4 + Math.random()*4 : 6 + Math.random()*4;
        m.userData.sway = Math.random() * Math.PI * 2;
        weatherGroup.add(m);
    }
    scene.add(weatherGroup);
}
function updateWeather(dt) {
    weatherTimer += dt;
    if (weatherTimer > 30) { weatherTimer = 0; setWeather(['clear','rain','snow','leaves'][Math.floor(Math.random()*4)]); }
    if (!weatherGroup) return;
    weatherGroup.children.forEach(p => {
        p.position.z += (state.baseSpeed * 0.5) * dt;
        p.position.y -= p.userData.speed * dt;
        if (weatherType === 'leaves' || weatherType === 'snow') { p.userData.sway += dt*2; p.position.x += Math.sin(p.userData.sway) * dt * 3; }
        if (p.position.y < 0 || p.position.z > 15) {
            p.position.y = 15 + Math.random()*10; p.position.x = -14 + Math.random()*28; p.position.z = -Math.random()*100;
        }
    });
}

