function updateCameraTarget(dt) {
    const px = state.playerX;
    let targetPos, targetLook;
    if (state.cutsceneActive) return;
    else if (state.inMenu) {
        const t = performance.now() / 5000;
        targetPos = new THREE.Vector3(Math.sin(t) * 5.5, 4.5, Math.cos(t) * 5.5 + 2);
        targetLook = new THREE.Vector3(0, 1.3, -0.5);
    } else if (state.cameraMode === 'diagonal' && state.cameraSpecialActive) {
        targetPos = new THREE.Vector3(12, 6, 9);
        targetLook = new THREE.Vector3(px * 0.3, 1.4, -3);
    } else if (state.cameraMode === 'top' && state.cameraSpecialActive) {
        targetPos = new THREE.Vector3(px * 0.3, 16, 4);
        targetLook = new THREE.Vector3(px * 0.3, 0.8, -4);
    } else {
        targetPos = new THREE.Vector3(px * 0.4, 6, 9);
        targetLook = new THREE.Vector3(px * 0.4, 1.5, -5);
    }
    const lerp = 1 - Math.pow(0.001, dt);
    state.cameraCurrent.pos.lerp(targetPos, lerp);
    state.cameraCurrent.look.lerp(targetLook, lerp);
    camera.position.copy(state.cameraCurrent.pos);
    camera.lookAt(state.cameraCurrent.look);

    const sx = state.playerX * 0.4;
    sun.position.set(sx + 12, 22, 15);
    sunTarget.position.set(sx, 0, -6);
    sunTarget.updateMatrixWorld();
}
function updateCameraSpecial(dt) {
    if (state.bossActive) {
        if (state.cameraSpecialActive) {
            state.cameraSpecialActive = false;
            state.cameraMode = 'back';
        }
        return;
    }
    if (state.cameraSpecialActive) {
        state.cameraSpecialTimer += dt * 60;
        if (state.cameraSpecialTimer > 15 * 60) {
            state.cameraSpecialActive = false; state.cameraSpecialTimer = 0;
            state.cameraSpecialCooldown = (60 + Math.random() * 30) * 60;
            state.cameraMode = 'back';
        }
        return;
    }
    state.cameraSpecialCooldown -= dt * 60;
    if (state.cameraSpecialCooldown <= 0) {
        state.cameraSpecialActive = true; state.cameraSpecialTimer = 0;
        state.cameraMode = Math.random() < 0.5 ? 'diagonal' : 'top';
        showToast(state.cameraMode === 'diagonal' ? 'Вид сбоку!' : 'Вид сверху!');
    }
}

