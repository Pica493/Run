    <symbol id="i-medal" viewBox="0 0 24 24"><circle cx="12" cy="15" r="6" fill="#FFD700" stroke="#B8860B" stroke-width="1.5"/><circle cx="12" cy="15" r="3.5" fill="#FFC700"/><path d="M8 3 L12 10 L16 3 L14 9 L10 9 Z" fill="#e94560" stroke="#8B0000"/></symbol>
