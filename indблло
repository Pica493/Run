let _lastCoinSfx = 0;
function checkCollisions() {
    if (state.bossActive && bossGroup.visible) {
        const dx = Math.abs(bossGroup.position.x - state.playerX);
        const dz = Math.abs(bossGroup.position.z);
        const dy = Math.abs((state.playerY + 1) - (bossGroup.position.y + 1.5));
        if (dx < 2.2 && dz < 1.6 && dy < 2.7) {
            if (state.bonusShield > 0) { damageBoss(); if (state.bossActive) bossGroup.position.z = -85; }
            else if (state.invuln > 0) {}
            else { gameOver(); return; }
        }
    }
    for (let i = state.obstacles.length - 1; i >= 0; i--) {
        const obs = state.obstacles[i];
        const dx = Math.abs(obs.position.x - state.playerX);
        const dz = Math.abs(obs.position.z);
        if (dx > 1.3 || dz > 1.3) continue;
        const playerH = state.rolling ? 0.8 : 2.1;
        const pTop = state.playerY + playerH, pBot = state.playerY;
        let oTop, oBot;
        if (obs.userData.type === 'low')           { oTop = 1.4; oBot = 0; }
        else if (obs.userData.type === 'overhead') { oTop = 3.2; oBot = 1.5; }
        else                                        { oTop = 3.0; oBot = 0; }
        if (pTop > oBot && pBot < oTop) {
            if (state.invuln > 0) continue;
            if (state.bonusShield > 0) {
                scene.remove(obs); state.obstacles.splice(i, 1);
                emitParticles(obs.position.x, 1, obs.position.z, 0x4ce0ff, 10);
                audio.sfxBonus(); continue;
            }
            gameOver(); return;
        }
    }
    if (state.over) return;

    const magnetRange = state.bonusMagnet > 0 ? 5 : 1.4;
    for (let i = state.coins.length - 1; i >= 0; i--) {
        const c = state.coins[i];
        if (c.userData.collected) continue;
        const dx = Math.abs(c.position.x - state.playerX), dz = Math.abs(c.position.z);
        if (dx < magnetRange && dz < magnetRange && Math.abs(c.position.y - (state.playerY + 1)) < 2.2) {
            c.userData.collected = true; scene.remove(c); state.coins.splice(i, 1);
            const modeMul = getCurrentMode().coinMul;
            const gained = Math.max(1, Math.floor(modeMul));
            state.coinsThisRun += gained;
            save.coins += gained;
            save.totalCoins += gained;
            state.score += 2 * gained;
            debouncedLocalSave(); debouncedCloudSave();
            const now = performance.now();
            if (now - _lastCoinSfx > 40) { audio.sfxCoin(); _lastCoinSfx = now; }
            updateMissions('coins', 1); checkAchievements();
        }
    }
    for (let i = state.bonuses.length - 1; i >= 0; i--) {
        const b = state.bonuses[i];
        if (b.userData.collected) continue;
        const dx = Math.abs(b.position.x - state.playerX), dz = Math.abs(b.position.z);
        if (dx < 1.6 && dz < 1.6 && Math.abs(b.position.y - (state.playerY + 1)) < 1.9) {
            b.userData.collected = true; scene.remove(b); state.bonuses.splice(i, 1);
            activateBonus(b.userData.type);
        }
    }
}
function activateBonus(type) {
    audio.sfxBonus();
    if (type === 'shield')        state.bonusShield = 20 * 60;
    else if (type === 'magnet')   { state.bonusMagnet = 20 * 60; save.magnetsUsed = (save.magnetsUsed||0)+1; debouncedLocalSave(); checkAchievements(); }
    else if (type === 'sneakers') { state.bonusSneakers = 20 * 60; save.sneakersUsed = (save.sneakersUsed||0)+1; debouncedLocalSave(); checkAchievements(); }
    else if (type === 'jetpack')  { state.bonusJetpack = 20 * 60; state.vy = 4; state.onGround = false; save.jetpacksUsed = (save.jetpacksUsed||0)+1; debouncedLocalSave(); checkAchievements(); }
    updateMissions('bonus', 1);
    showToast('Бонус: ' + (type === 'shield' ? 'Щит' : type === 'magnet' ? 'Магнит' : type === 'sneakers' ? 'Супер-ботинки' : 'Джетпак'));
}
