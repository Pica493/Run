    <symbol id="i-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 11 L12 3 L21 11 V21 H14 V15 H10 V21 H3 Z"/></symbol>
    <symbol id="i-pause" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16" rx="1" fill="currentColor"/><rect x="14" y="4" width="4" height="16" rx="1" fill="currentColor"/></symbol>
    <symbol id="i-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></symbol>
    <symbol id="i-restart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1015-6.7L21 8M21 3v5h-5"/></symbol>
    <symbol id="i-modes" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></symbol>
    <symbol id="i-ad" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M10 9l5 3-5 3z" fill="currentColor"/><path d="M8 22h8"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 2 L20 5 v8 Q20 19 12 22 Q4 19 4 13 V5 Z" fill="currentColor" stroke="#0a4a6a" stroke-width="1.5"/><path d="M12 6 L16 8 v5 Q16 16 12 18 Q8 16 8 13 V8 Z" fill="#a8f0ff" opacity=".6"/></symbol>
    <symbol id="i-magnet" viewBox="0 0 24 24"><path d="M4 12 v-4 a8 8 0 0116 0 v4 h-5 v-4 a3 3 0 00-6 0 v4 Z" fill="currentColor"/><rect x="4" y="12" width="5" height="5" fill="#4ce0ff"/><rect x="15" y="12" width="5" height="5" fill="#4ce0ff"/></symbol>
