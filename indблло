        ctx.fillStyle = '#000';
        ctx.fillRect(cx - 6*s, baseY - 47*s, 12*s, 1.5*s);
        ctx.fillStyle = '#c0392b';
        ctx.beginPath(); ctx.moveTo(cx, baseY - 55*s); ctx.lineTo(cx - 2*s, baseY - 62*s); ctx.lineTo(cx + 2*s, baseY - 62*s); ctx.closePath(); ctx.fill();
    } else if (skin.type === 'astro') {
