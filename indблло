    let html = '';
    if (state.bonusShield > 0)   html += `<div class="pw-item shield"><svg class="ico"><use href="#i-shield"/></svg> ${Math.ceil(state.bonusShield/60)}с</div>`;
    if (state.bonusMagnet > 0)   html += `<div class="pw-item magnet"><svg class="ico"><use href="#i-magnet"/></svg> ${Math.ceil(state.bonusMagnet/60)}с</div>`;
    if (state.bonusSneakers > 0) html += `<div class="pw-item sneakers"><svg class="ico"><use href="#i-sneakers"/></svg> ${Math.ceil(state.bonusSneakers/60)}с</div>`;
    if (state.bonusJetpack > 0)  html += `<div class="pw-item jetpack"><svg class="ico"><use href="#i-jetpack"/></svg> ${Math.ceil(state.bonusJetpack/60)}с</div>`;
    if (html === _lastPwHtml) return;
    _lastPwHtml = html;
    document.getElementById('powerups').innerHTML = html;
}

