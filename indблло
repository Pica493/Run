        ctx.beginPath(); ctx.moveTo(cx - 8*s, baseY - 52*s); ctx.lineTo(cx, baseY - 68*s); ctx.lineTo(cx + 8*s, baseY - 52*s); ctx.closePath(); ctx.fill();
        roundRect(ctx, cx - 10*s, baseY - 54*s, 20*s, 2*s, 1*s); ctx.fill();
        ctx.fillStyle = '#ecf0f1';
        ctx.beginPath(); ctx.moveTo(cx - 4*s, baseY - 42*s); ctx.lineTo(cx, baseY - 32*s); ctx.lineTo(cx + 4*s, baseY - 42*s); ctx.closePath(); ctx.fill();
        ctx.fillStyle = '#000';
        ctx.beginPath(); ctx.arc(cx - 2*s, baseY - 47*s, 1*s, 0, Math.PI*2); ctx.fill();
        ctx.beginPath(); ctx.arc(cx + 2*s, baseY - 47*s, 1*s, 0, Math.PI*2); ctx.fill();
    } else if (skin.type === 'alien') {
        ctx.fillStyle = '#27ae60';
        ctx.beginPath(); ctx.arc(cx, baseY - 47*s, 7*s, 0, Math.PI*2); ctx.fill();
        ctx.fillStyle = acc;
        ctx.beginPath(); ctx.arc(cx, baseY - 45*s, 1.8*s, 0, Math.PI*2); ctx.fill();
        ctx.beginPath(); ctx.arc(cx - 3*s, baseY - 48*s, 1.8*s, 0, Math.PI*2); ctx.fill();
        ctx.beginPath(); ctx.arc(cx + 3*s, baseY - 48*s, 1.8*s, 0, Math.PI*2); ctx.fill();
        ctx.fillRect(cx - 5*s, baseY - 54*s, 0.8*s, 4*s);
        ctx.fillRect(cx + 4*s, baseY - 54*s, 0.8*s, 4*s);
    }
    if (save.currentSkin === skin.id) {
        ctx.font = 'bold ' + (12*s) + 'px monospace';
        ctx.textAlign = 'right'; ctx.fillStyle = '#4caf50';
        ctx.fillText('✓', W - 6, 14);
    }
}

function renderShop() {
    const grid = document.getElementById('skinGrid'); grid.innerHTML = '';
    const sorted = SKINS.slice().sort((a, b) => a.price - b.price);
    sorted.forEach(skin => {
        const owned = save.skins.includes(skin.id);
        const selected = save.currentSkin === skin.id;
        const div = document.createElement('div');
        div.className = 'card' + (selected ? ' selected' : '') + (owned ? ' owned' : '');
        const cv = document.createElement('canvas');
        cv.width = 96; cv.height = 96; cv.className = 'preview';
        drawSkinPreview(cv, skin);
        div.appendChild(cv);
        const info = document.createElement('div');
        info.innerHTML = `<div class="name">${skin.name}</div><div class="price">${owned ? (selected ? '✓ Выбран' : 'Выбрать') : '<svg class="ico"><use href="#i-coin"/></svg>' + skin.price}</div>`;
        div.appendChild(info);
        div.addEventListener('click', () => {
            audio.sfxClick();
            if (owned) {
                save.currentSkin = skin.id; saveSave(); debouncedCloudSave(); renderShop(); checkAchievements(); applySkin(skin.id);
            } else if (save.coins >= skin.price) {
                save.coins -= skin.price; save.skins.push(skin.id); save.currentSkin = skin.id;
                saveSave(); debouncedCloudSave(); renderShop(); updateMenuCoins(); checkAchievements(); applySkin(skin.id);
                showToast('Куплен: ' + skin.name);
            } else showToast('Недостаточно монет!');
        });
        grid.appendChild(div);
    });
}
function renderModes() {
    const grid = document.getElementById('modesGrid'); grid.innerHTML = '';
    MODES.forEach(m => {
        const div = document.createElement('div');
        div.className = 'card' + (state.mode === m.id ? ' selected' : '');
        div.innerHTML = `<div style="font-size:32px;margin-bottom:6px">${m.icon}</div><div class="name" style="font-size:14px;font-weight:bold;color:#fff">${m.name}</div><div style="font-size:11px;color:#aaa;margin:4px 0">${m.desc}</div>`;
        div.addEventListener('click', () => { audio.sfxClick(); state.mode = m.id; renderModes(); showToast('Режим: ' + m.name); });
        grid.appendChild(div);
    });
}
function renderAchievements() {
    const list = document.getElementById('achievementsList'); list.innerHTML = '';
    let unlocked = 0;
    ACHIEVEMENTS.forEach(a => {
        const isU = save.achievements.includes(a.id);
        if (isU) unlocked++;
        const div = document.createElement('div');
        div.className = 'achievement-card' + (isU ? ' unlocked' : '');
        div.innerHTML = `<span class="icon">${isU ? a.icon : '🔒'}</span><div class="text"><div class="title">${a.title}</div><div class="desc">${a.desc}</div></div>`;
        list.appendChild(div);
    });
    document.getElementById('achProgress').textContent = unlocked + '/' + ACHIEVEMENTS.length;
}
async function renderLeaderboard() {
    const list = document.getElementById('leaderboardList');
    list.innerHTML = '<div style="color:#888;padding:20px;text-align:center">Загрузка...</div>';
    if (!ysdk || !ysdk.leaderboards) {
        list.innerHTML = `<div class="leaderboard-row me"><span class="rank">1</span><span class="nick">Вы</span><span class="score">${save.best}</span></div><div style="color:#888;margin-top:12px;font-size:13px;text-align:center">Полный лидерборд доступен в Яндекс Играх</div>`;
        return;
    }
    try {
        const result = await ysdk.leaderboards.getLeaderboardEntries('best_score', { quantityTop: 10, includeUser: true, quantityAround: 3 });
        list.innerHTML = '';
        if (!result || !result.entries || !result.entries.length) { list.innerHTML = '<div style="color:#888;padding:20px">Пока нет результатов</div>'; return; }
        const myId = ysdkPlayer ? ysdkPlayer.uniqueID : null;
        result.entries.forEach(entry => {
            const playerId = entry.player ? entry.player.uniqueID : null;
            const isMe = myId && playerId === myId;
            const div = document.createElement('div');
            div.className = 'leaderboard-row' + (isMe ? ' me' : '');
            div.innerHTML = `<span class="rank">${entry.rank}</span><span class="nick">${(entry.player && entry.player.publicName) || 'Аноним'}</span><span class="score">${entry.score}</span>`;
            list.appendChild(div);
        });
    } catch (e) { list.innerHTML = '<div style="color:#888;padding:20px">Не удалось загрузить</div>'; }
}
function applyZone(idx, silent) {
    if (idx === currentZone && decorGroup.children.length > 0) return;
    currentZone = idx;
    const z = ZONES[idx];
    scene.background.setHex(z.sky); scene.fog.color.setHex(z.sky); scene.fog.far = z.fogFar;
    groundMat.color.setHex(z.ground); wallMat.color.setHex(z.wall);
    document.getElementById('zoneLabel').textContent = z.name;
    spawnDecor();
    if (!silent) audio.sfxZone();
    if (!save.zonesVisitedSet.includes(idx)) {
        save.zonesVisitedSet.push(idx); save.zonesVisited = save.zonesVisitedSet.length;
        debouncedLocalSave(); checkAchievements();
    }
}

// ============ КНОПКИ ============
document.getElementById('splashStartBtn').onclick = () => {
    audio.start();
    const splash = document.getElementById('splashScreen');
    splash.classList.add('hide');
    setTimeout(() => { splash.style.display = 'none'; }, 600);
    if (!save.cutsceneShown) setTimeout(() => startCutscene(), 300);
    else setTimeout(() => showMenu(), 300);
};
document.getElementById('skipCutsceneBtn').onclick = () => endCutscene();
document.getElementById('startBtn').onclick = () => { audio.start(); audio.sfxClick(); startGame(); };
document.getElementById('restartBtn').onclick = () => { audio.sfxClick(); startGame(); };
document.getElementById('menuBtn').onclick = () => { audio.sfxClick(); goToMenu(); };
document.getElementById('pauseMenuBtn').onclick = () => { audio.sfxClick(); goToMenu(); };
document.getElementById('resumeBtn').onclick = () => { audio.sfxClick(); togglePause(); };
document.getElementById('pauseBtn').onclick = () => { audio.sfxClick(); togglePause(); };
document.getElementById('shopBtn').onclick = () => { audio.sfxClick(); renderShop(); switchScreen('startScreen', 'shopScreen'); };
document.getElementById('closeShopBtn').onclick = () => { audio.sfxClick(); switchScreen('shopScreen', 'startScreen'); updateMenuCoins(); };
document.getElementById('achievementsBtn').onclick = () => { audio.sfxClick(); renderAchievements(); switchScreen('startScreen', 'achievementsScreen'); };
document.getElementById('closeAchBtn').onclick = () => { audio.sfxClick(); switchScreen('achievementsScreen', 'startScreen'); };
document.getElementById('leaderboardBtn').onclick = () => { audio.sfxClick(); renderLeaderboard(); switchScreen('startScreen', 'leaderboardScreen'); };
document.getElementById('closeLbBtn').onclick = () => { audio.sfxClick(); switchScreen('leaderboardScreen', 'startScreen'); };
document.getElementById('modesBtn').onclick = () => { audio.sfxClick(); renderModes(); switchScreen('startScreen', 'modesScreen'); };
document.getElementById('closeModesBtn').onclick = () => { audio.sfxClick(); switchScreen('modesScreen', 'startScreen'); };
document.getElementById('dailyBtn').onclick = () => { audio.sfxClick(); claimDaily(); };
document.getElementById('missionsBtn').onclick = () => { audio.sfxClick(); renderMissions(); switchScreen('startScreen', 'missionsScreen'); };
document.getElementById('closeMissionsBtn').onclick = () => { audio.sfxClick(); switchScreen('missionsScreen', 'startScreen'); };
document.getElementById('wheelBtn').onclick = () => { audio.sfxClick(); drawWheel(); updateWheelUI(); switchScreen('startScreen', 'wheelScreen'); };
document.getElementById('closeWheelBtn').onclick = () => { audio.sfxClick(); switchScreen('wheelScreen', 'startScreen'); updateMenuCoins(); };
document.getElementById('spinBtn').onclick = () => { audio.sfxClick(); spinWheel(); };
document.getElementById('reviveBtn').onclick = () => { audio.sfxClick(); if (state.reviveUsed) return; showRewardedAd(() => revivePlayer(), () => showToast('Реклама недоступна')); };
document.getElementById('doubleCoinsBtn').onclick = () => {
    audio.sfxClick();
    if (state.doubleCoinsUsed || state.coinsThisRun < 1) return;
    const gain = state.coinsThisRun;
    showRewardedAd(() => {
        state.doubleCoinsUsed = true;
        save.coins += gain; save.totalCoins += gain;
        saveSave(); debouncedCloudSave(); updateHUD(); updateMenuCoins();
        document.getElementById('doubleCoinsBtn').style.display = 'none';
        showToast('+' + gain + ' монет за просмотр!'); checkAchievements();
    }, () => showToast('Реклама недоступна'));
};

// ============ ЗАПУСК ============
applySkin(save.currentSkin);
applyZone(0, true);
updateMenuCoins();
updateHUD();
generateMissions();
initSDK();
requestAnimationFrame(animate);
</script>
