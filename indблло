</svg>

<canvas id="gameCanvas"></canvas>

<div id="splashScreen">
    <div class="splash-bg-cars">
        <div class="splash-city"></div>
        <div class="splash-windows"></div>
        <div class="splash-fog"></div>
    </div>
    <div class="splash-title">
        <div class="num">3D</div>
        <div class="line1">ПОБЕГ</div>
        <div class="line2">ИЗ ГОРОДА</div>
        <div class="subtitle">БЕСКОНЕЧНЫЙ ЗАБЕГ</div>
    </div>
    <button id="splashStartBtn">▶ НАЧАТЬ</button>
</div>

<div id="cutsceneOverlay">
    <div id="cutsceneSubtitle"></div>
    <button id="skipCutsceneBtn">ПРОПУСТИТЬ ▶</button>
    <div id="cutsceneProgress"><div id="cutsceneProgressBar"></div></div>
</div>

<div id="hud" class="hidden-hud">
    <div>Счёт: <span id="score">0</span></div>
    <div class="coins"><svg class="ico"><use href="#i-coin"/></svg> <span id="coins">0</span></div>
    <div class="zone" id="zoneLabel">День</div>
    <div class="timer" id="timerLabel" style="display:none;">60</div>
</div>
<div id="powerups"></div>
<div id="quickCoins" class="hidden-q"><svg class="ico"><use href="#i-coin"/></svg><span id="quickCoinsVal">0</span></div>
<button id="pauseBtn"><svg class="ico"><use href="#i-pause"/></svg></button>
<div id="toast"></div>

<div id="startScreen" class="overlay">
    <h1>🏃 3D ПОБЕГ ИЗ ГОРОДА</h1>
    <div style="color:#aac;font-size:12px;letter-spacing:2px;margin-bottom:8px;">БЕСКОНЕЧНЫЙ ЗАБЕГ</div>
    <div class="coins-display"><svg class="ico-lg"><use href="#i-coin"/></svg> <span id="menuCoins">0</span></div>
    <div class="controls-info"><b>Управление:</b><br>← → — смена полосы<br>↑ / W — прыжок<br>↓ / S — кувырок<br>Свайпы на телефоне</div>
    <div class="btn-stack">
        <button id="startBtn"><svg><use href="#i-play"/></svg> ИГРАТЬ</button>
        <button id="modesBtn" class="secondary"><svg><use href="#i-modes"/></svg> РЕЖИМЫ</button>
        <button id="dailyBtn" class="gold"><svg><use href="#i-gift"/></svg> ЕЖЕДНЕВНЫЙ БОНУС</button>
        <button id="missionsBtn" class="secondary"><svg><use href="#i-list"/></svg> МИССИИ</button>
        <button id="wheelBtn" class="secondary"><svg><use href="#i-wheel"/></svg> КОЛЕСО ФОРТУНЫ</button>
        <button id="shopBtn" class="secondary"><svg><use href="#i-shop"/></svg> МАГАЗИН</button>
        <button id="achievementsBtn" class="secondary"><svg><use href="#i-medal"/></svg> ДОСТИЖЕНИЯ</button>
        <button id="leaderboardBtn" class="secondary"><svg><use href="#i-trophy"/></svg> РЕКОРДЫ</button>
    </div>
</div>

<div id="modesScreen" class="overlay">
    <h1><svg><use href="#i-modes"/></svg> Режимы</h1>
    <div class="grid-2" id="modesGrid"></div>
    <button id="closeModesBtn" class="secondary"><svg><use href="#i-back"/></svg> НАЗАД</button>
</div>

<div id="shopScreen" class="overlay">
    <h1><svg><use href="#i-shop"/></svg> Персонажи</h1>
    <p>Монет: <span class="accent" id="shopCoins">0</span></p>
    <div class="grid-3" id="skinGrid"></div>
    <button id="closeShopBtn" class="secondary"><svg><use href="#i-back"/></svg> НАЗАД</button>
</div>

<div id="missionsScreen" class="overlay">
    <h1><svg><use href="#i-list"/></svg> Миссии дня</h1>
    <div style="display:flex;flex-direction:column;gap:10px;width:100%;max-width:380px;margin-top:14px" id="missionsList"></div>
    <button id="closeMissionsBtn" class="secondary" style="margin-top:15px"><svg><use href="#i-back"/></svg> НАЗАД</button>
