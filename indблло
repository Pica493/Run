    const bossMat = new THREE.MeshStandardMaterial({ color:0x8b0000, emissive:0x440000, emissiveIntensity:.5, metalness:.5, roughness:.5 });
    const darkMat = new THREE.MeshStandardMaterial({ color:0x5c0000, metalness:.5, roughness:.5 });
    const body = new THREE.Mesh(new THREE.SphereGeometry(1.1, 24, 18), bossMat);
    body.position.y = 1.3; body.scale.set(1, 1.15, 0.9); body.castShadow = true;
    g.add(body);
    const head = new THREE.Mesh(new THREE.SphereGeometry(0.85, 24, 18), darkMat);
    head.position.y = 2.85; head.castShadow = true;
    g.add(head);
    const eyeMat = new THREE.MeshBasicMaterial({ color:0xffdd00 });
    const eye1 = new THREE.Mesh(new THREE.SphereGeometry(0.22, 14, 12), eyeMat);
    eye1.position.set(0, 2.95, -0.7); g.add(eye1);
    const eye2 = eye1.clone(); eye2.position.set(0.45, 2.9, -0.55); g.add(eye2);
    const eye3 = eye1.clone(); eye3.position.set(-0.45, 2.9, -0.55); g.add(eye3);
    const pupilMat = new THREE.MeshBasicMaterial({ color:0x000000 });
    const pupil1 = new THREE.Mesh(new THREE.SphereGeometry(0.09, 10, 8), pupilMat);
    pupil1.position.set(0, 2.95, -0.87); g.add(pupil1);
    const hornMat2 = new THREE.MeshStandardMaterial({ color:0x1a1a1a, roughness:.6, metalness:.3 });
    const hornL2 = new THREE.Mesh(new THREE.ConeGeometry(0.18, 0.85, 10), hornMat2);
    hornL2.position.set(-0.55, 3.55, 0); hornL2.rotation.z = 0.4; hornL2.castShadow = true;
    g.add(hornL2);
    const hornR2 = hornL2.clone(); hornR2.position.x = 0.55; hornR2.rotation.z = -0.4;
    g.add(hornR2);
    const legL = new THREE.Mesh(new THREE.CylinderGeometry(0.28, 0.25, 1.0, 12), bossMat);
    legL.position.set(-0.4, 0.5, 0); legL.castShadow = true;
    g.add(legL);
    const legR = legL.clone(); legR.position.x = 0.4; g.add(legR);
    const footMat = new THREE.MeshStandardMaterial({ color:0x1a1a1a, roughness:.9 });
    const footL = new THREE.Mesh(new THREE.SphereGeometry(0.3, 12, 10), footMat);
    footL.scale.set(1, 0.6, 1.4); footL.position.set(-0.4, 0.15, 0); footL.castShadow = true;
    g.add(footL);
    const footR = footL.clone(); footR.position.x = 0.4; g.add(footR);
    g.userData.leg1 = legL; g.userData.leg2 = legR;
    g.userData.foot1 = footL; g.userData.foot2 = footR;
    return g;
}

function setupCutsceneScene() {
    state.obstacles.forEach(o => scene.remove(o));
    state.coins.forEach(c => scene.remove(c));
    state.bonuses.forEach(b => scene.remove(b));
    state.platforms.forEach(p => scene.remove(p.mesh));
    state.obstacles = []; state.coins = []; state.bonuses = []; state.platforms = [];
    bossGroup.visible = false;
    decorGroup.visible = false; lineGroup.visible = false;
    ground.visible = false; wallL.visible = false; wallR.visible = false;
    if (weatherGroup) weatherGroup.visible = false;

    scene.background = new THREE.Color(0x0a0a2e);
    scene.fog = new THREE.Fog(0x0a0a2e, 15, 45);

    cutsceneBrickPile = new THREE.Group();
    const brickMat = new THREE.MeshStandardMaterial({ color:0xb85c38, roughness:.9, metalness:.05 });
    const brickMat2 = new THREE.MeshStandardMaterial({ color:0x9c4828, roughness:.9, metalness:.05 });
    const brickGeo = new THREE.BoxGeometry(0.65, 0.3, 0.42);
    for (let i = 0; i < 14; i++) {
        const b = new THREE.Mesh(brickGeo, Math.random() < 0.5 ? brickMat : brickMat2);
        b.position.set((Math.random()-.5)*2.2, 0.15 + i * 0.3, (Math.random()-.5)*1.6);
        b.rotation.y = Math.random() * Math.PI;
        b.rotation.z = (Math.random()-.5) * 0.1;
        b.castShadow = true; b.receiveShadow = true;
        cutsceneBrickPile.add(b);
    }
    for (let i = 0; i < 4; i++) {
        const b = new THREE.Mesh(brickGeo, brickMat);
        b.position.set(-1.05 + i * 0.7, 4.35, 0);
        b.castShadow = true;
        cutsceneBrickPile.add(b);
    }
    cutsceneBrickPile.position.set(0, 0, -3);
    scene.add(cutsceneBrickPile);

    const skin = SKINS.find(s => s.id === save.currentSkin) || SKINS[0];
    cutscenePlayer = buildSmoothPlayerMesh(skin);
    cutscenePlayer.position.set(0.2, 4.5, -3);
    scene.add(cutscenePlayer);

    cutsceneBoss = buildSmoothBoss();
    cutsceneBoss.position.set(0, 0, -30);
    cutsceneBoss.rotation.y = Math.PI;
    scene.add(cutsceneBoss);

    const csLight = new THREE.PointLight(0xffaa55, 1.8, 35);
    csLight.position.set(6, 10, 6);
    scene.add(csLight);
    const csLight2 = new THREE.PointLight(0x6688ff, 0.6, 25);
    csLight2.position.set(-6, 6, -8);
    scene.add(csLight2);
    cutscene = { light: csLight, light2: csLight2 };
}

function teardownCutsceneScene() {
    if (cutsceneBrickPile) scene.remove(cutsceneBrickPile);
    if (cutscenePlayer) scene.remove(cutscenePlayer);
    if (cutsceneBoss) scene.remove(cutsceneBoss);
    if (cutscene) {
        if (cutscene.light) scene.remove(cutscene.light);
        if (cutscene.light2) scene.remove(cutscene.light2);
    }
    cutsceneBrickPile = null; cutscenePlayer = null; cutsceneBoss = null;
    decorGroup.visible = true; lineGroup.visible = true;
    ground.visible = true; wallL.visible = true; wallR.visible = true;
    if (weatherGroup) weatherGroup.visible = true;
    scene.fog = new THREE.Fog(0x87ceeb, 60, 150);
    currentZone = -1;
    applyZone(0, true);
    // applySkin вызывается в showMenu
}

