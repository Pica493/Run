const PARTICLE_POOL_SIZE = 60;
const particlePool = [];
const particleGeo = new THREE.SphereGeometry(.1, 8, 6);
for (let i = 0; i < PARTICLE_POOL_SIZE; i++) {
    const mat = new THREE.MeshBasicMaterial({ color:0xffffff, transparent:true, opacity:0 });
    const mesh = new THREE.Mesh(particleGeo, mat);
    mesh.visible = false; mesh.userData = { vx:0, vy:0, vz:0, life:0 };
    scene.add(mesh); particlePool.push(mesh);
}
function emitParticles(x, y, z, color, count) {
    count = count || 10;
    let emitted = 0;
    for (let i = 0; i < PARTICLE_POOL_SIZE && emitted < count; i++) {
        const p = particlePool[i];
        if (p.userData.life > 0) continue;
        p.position.set(x, y, z);
        p.userData.vx = (Math.random()-.5)*6; p.userData.vy = Math.random()*5+1; p.userData.vz = (Math.random()-.5)*6;
        p.userData.life = 30; p.material.color.setHex(color); p.material.opacity = 1; p.visible = true;
        emitted++;
    }
}
function updateParticles(dt) {
    for (let i = 0; i < PARTICLE_POOL_SIZE; i++) {
        const p = particlePool[i];
        if (p.userData.life <= 0) continue;
        p.userData.life--;
        if (p.userData.life <= 0) { p.visible = false; continue; }
        p.position.x += p.userData.vx * dt; p.position.y += p.userData.vy * dt; p.position.z += p.userData.vz * dt;
        p.userData.vy -= 15 * dt;
        p.material.opacity = p.userData.life / 30;
    }
}

