function updateCutscene(dt) {
    if (!cutscene) return;
    cutscene.time += dt;
    const t = cutscene.time;

    cutscene.phases.forEach((p, i) => {
        if (t >= p.t && !cutscene.shownSubtitles[i]) {
            cutscene.shownSubtitles[i] = true;
            showCutsceneSubtitle(p.text);
        }
    });

    document.getElementById('cutsceneProgressBar').style.width = Math.min(100, (t / cutscene.duration) * 100) + '%';

    let camX, camY, camZ, lookX, lookY, lookZ;
    if (t < 3.5) {
        const k = Math.min(1, t / 3.5);
        const angle = -Math.PI/4 + k * 0.5;
        const radius = 8 - k * 2;
        camX = Math.sin(angle) * radius;
        camY = 6.5 - k * 1.5;
        camZ = Math.cos(angle) * radius + 4;
        lookX = 0.2; lookY = 4.7; lookZ = -3;
        if (cutscenePlayer) cutscenePlayer.position.y = 4.5 + Math.sin(t * 1.8) * 0.03;
    } else if (t < 5.0) {
        const k = (t - 3.5) / 1.5;
        camX = 4 + k * 2;
        camY = 6 - k * 1;
        camZ = 7 - k * 2;
        lookX = 0.2; lookY = 3; lookZ = -6;
        if (cutsceneBoss) {
            cutsceneBoss.position.z = -30 + k * 18;
            const rc = t * 14;
            if (cutsceneBoss.userData.leg1) cutsceneBoss.userData.leg1.rotation.x = Math.sin(rc) * 0.5;
            if (cutsceneBoss.userData.leg2) cutsceneBoss.userData.leg2.rotation.x = -Math.sin(rc) * 0.5;
            if (cutsceneBoss.userData.foot1) {
                cutsceneBoss.userData.foot1.position.z = Math.sin(rc) * 0.3;
                cutsceneBoss.userData.foot2.position.z = -Math.sin(rc) * 0.3;
            }
            cutsceneBoss.position.y = Math.abs(Math.sin(rc * 2)) * 0.12;
        }
        if (cutscenePlayer) cutscenePlayer.position.y = 4.5 + Math.sin(t * 3) * 0.05;
    } else if (t < 6.5) {
        const k = (t - 5.0) / 1.5;
        camX = 6 - k * 1;
        camY = 5 + k * 1;
        camZ = 5;
        lookX = 0.2; lookY = 4.7 - k * 2;
        lookZ = -3;
        if (cutscenePlayer) {
            cutscenePlayer.position.y = 4.5 - k * 2.5;
            cutscenePlayer.rotation.z = -k * 1.5;
        }
        if (cutsceneBoss) {
            cutsceneBoss.position.z = -12 + k * 3;
            const rc = t * 14;
            if (cutsceneBoss.userData.leg1) cutsceneBoss.userData.leg1.rotation.x = Math.sin(rc) * 0.5;
            if (cutsceneBoss.userData.leg2) cutsceneBoss.userData.leg2.rotation.x = -Math.sin(rc) * 0.5;
        }
    } else {
        const k = (t - 6.5) / 2.5;
        camX = 5;
        camY = 4.5 + Math.sin(t * 8) * 0.15;
        camZ = 3 - k * 2;
        lookX = 0.2; lookY = 2.5; lookZ = -3 - k * 10;
        if (cutscenePlayer) {
            cutscenePlayer.position.z = -3 - k * 12;
            cutscenePlayer.rotation.z = 0;
            cutscenePlayer.position.y = 1.5 + Math.abs(Math.sin(t * 14)) * 0.15;
        }
        if (cutsceneBoss) {
            cutsceneBoss.position.z = -9 - k * 12;
        }
    }

    camera.position.set(camX, camY, camZ);
    camera.lookAt(lookX, lookY, lookZ);

    if (t >= cutscene.duration) endCutscene();
}

function endCutscene() {
    state.cutsceneActive = false;
    document.getElementById('cutsceneOverlay').classList.remove('active');
    document.getElementById('cutsceneSubtitle').classList.remove('show');
    save.cutsceneShown = true; saveSave();
    teardownCutsceneScene();
    cutscene = null;
    showMenu();
}

// ============ ИГРОВОЙ ЦИКЛ ============
const FIXED_DT = 1/60;
let accumulator = 0, lastTime = performance.now();
let _lastTimerSec = -1;
let _achDirty = false, _achFlushTimer = 0;

function update(dt) {
    if (state.cutsceneActive) { updateCutscene(dt); return; }
    if (!state.playing || state.over || state.paused) return;
    if (state.invuln > 0) state.invuln--;
    if (state.coyoteTime > 0) state.coyoteTime--;
    if (state.jumpBuffer > 0) state.jumpBuffer--;
    if (state.rollTimer > 0) { state.rollTimer--; if (state.rollTimer <= 0) state.rolling = false; }
    if (state.bonusShield > 0) state.bonusShield--;
    if (state.bonusMagnet > 0) state.bonusMagnet--;
    if (state.bonusSneakers > 0) state.bonusSneakers--;
    if (state.bonusJetpack > 0) state.bonusJetpack--;
    updatePowerupDisplay();

    if (state.mode === 'time' && state.timeLeft > 0) {
        state.timeLeft -= dt;
        const sec = Math.ceil(Math.max(0, state.timeLeft));
        if (sec !== _lastTimerSec) {
            _lastTimerSec = sec;
            document.getElementById('timerLabel').textContent = sec;
        }
        if (state.timeLeft <= 0) { gameOver(); return; }
    }

    state.playerX += (state.targetX - state.playerX) * Math.min(1, 18 * dt);
    playerGroup.position.x = state.playerX;

    let supportY = 0;
    for (const p of state.platforms) {
        const pz = p.mesh.position.z;
        const nearZ = pz + p.length / 2, farZ = pz - p.length / 2;
        if (nearZ > -0.3 && farZ < 0.3) {
            if (state.playerX > p.x - p.halfW - 0.2 && state.playerX < p.x + p.halfW + 0.2) {
                if (state.playerY >= p.topY - 0.15) supportY = Math.max(supportY, p.topY);
            }
        }
    }

    if (state.jumpBuffer > 0 && (state.onGround || state.coyoteTime > 0) && !state.rolling) {
        let jv = JUMP_VELOCITY;
        if (state.bonusSneakers > 0) jv *= 1.55;
        state.vy = jv; state.onGround = false; state.coyoteTime = 0; state.jumpBuffer = 0;
        audio.sfxJump();
    }
    if (state.bonusJetpack > 0) {
        if (state.playerY < 5.5) state.vy = 3; else state.vy = Math.max(state.vy - 8 * dt, 0);
        state.onGround = false;
    } else if (!state.onGround) {
        state.vy -= GRAVITY * dt;
        if (state.vy < -MAX_FALL) state.vy = -MAX_FALL;
    }
    if (!state.onGround) {
        state.playerY += state.vy * dt;
        if (state.playerY <= supportY) { state.playerY = supportY; state.vy = 0; state.onGround = true; }
    } else {
        state.coyoteTime = 6;
        if (state.playerY > supportY + 0.05) state.onGround = false;
        else state.playerY = supportY;
    }
    playerGroup.position.y = state.playerY;

    if (state.rolling) {
        const a = (30 - state.rollTimer) / 30 * Math.PI * 2;
        playerGroup.rotation.x = a;
        playerGroup.position.y = state.playerY + 0.9 * (1 - Math.cos(a)) * 0.5;
    } else if (state.onGround) {
        playerGroup.rotation.x = 0;
        playerGroup.position.y = state.playerY;
        state.walkCycle += dt * 14;
        const swing = Math.sin(state.walkCycle) * 0.7;
        if (playerParts.legL) playerParts.legL.rotation.x = swing;
        if (playerParts.legR) playerParts.legR.rotation.x = -swing;
        if (playerParts.armL) playerParts.armL.rotation.x = -swing * 0.8;
        if (playerParts.armR) playerParts.armR.rotation.x = swing * 0.8;
        const off = Math.abs(Math.sin(state.walkCycle)) * 0.03;
        if (playerParts.torso) playerParts.torso.position.y = 0.95 + off;
        if (playerParts.head) playerParts.head.position.y = 1.72 + off;
    } else {
        playerGroup.rotation.x = 0;
        if (playerParts.legL) playerParts.legL.rotation.x = -0.3;
        if (playerParts.legR) playerParts.legR.rotation.x = 0.3;
        if (playerParts.armL) playerParts.armL.rotation.x = -1.2;
        if (playerParts.armR) playerParts.armR.rotation.x = -1.2;
    }

    const modeMul = getCurrentMode().speedMul;
    const effectiveSpeed = state.baseSpeed * modeMul;

    lineGroup.children.forEach(l => { l.position.z += effectiveSpeed * dt; if (l.position.z > 10) l.position.z -= 320; });
    decorGroup.children.forEach(d => { d.position.z += effectiveSpeed * dt; if (d.position.z > 20) d.position.z -= 300; });

    for (let i = state.platforms.length - 1; i >= 0; i--) {
        const p = state.platforms[i];
        p.mesh.position.z += effectiveSpeed * dt;
        if (p.mesh.position.z - p.length / 2 > 15) { scene.remove(p.mesh); state.platforms.splice(i, 1); }
    }

    for (let i = state.obstacles.length - 1; i >= 0; i--) {
        const obs = state.obstacles[i];
        obs.position.z += effectiveSpeed * dt;
        if (obs.position.z > 12) {
            scene.remove(obs); state.obstacles.splice(i, 1);
            state.score++;
            if (state.score >= state.nextZoneAt) {
                state.nextZoneAt += state.zoneThreshold;
                applyZone((currentZone + 1) % ZONES.length);
            }
            if (state.score >= state.bossNextAt && !state.bossActive) { state.bossNextAt += 400; spawnBoss(); }
            updateMissions('score', 1);
        }
    }

    if (state.bossActive && bossGroup.visible) {
        bossGroup.position.z += effectiveSpeed * dt * 0.5;
        bossGroup.userData.laneTimer += dt;
        if (bossGroup.userData.laneTimer > 1.8) {
            bossGroup.userData.laneTimer = 0;
            const opts = [0, 1, 2].filter(l => l !== bossGroup.userData.targetLane);
            bossGroup.userData.targetLane = opts[Math.floor(Math.random() * opts.length)];
        }
        const tX = LANES[bossGroup.userData.targetLane];
        bossGroup.position.x += (tX - bossGroup.position.x) * Math.min(1, dt * 1.5);
        bossGroup.userData.phase += dt * 2;
        bossGroup.rotation.z = Math.sin(bossGroup.userData.phase) * 0.1;
        if (bossGroup.userData.hitFlash > 0) {
            bossGroup.userData.hitFlash--;
            bossBodyMat.emissiveIntensity = 0.6 + (bossGroup.userData.hitFlash / 10) * 1.5;
        }
        if (bossGroup.position.z > 14) { bossGroup.visible = false; state.bossActive = false; }
    }

    for (let i = state.coins.length - 1; i >= 0; i--) {
        const c = state.coins[i];
        c.position.z += effectiveSpeed * dt;
        c.rotation.y += dt * 4;
        if (c.position.z > 12) { scene.remove(c); state.coins.splice(i, 1); }
    }
    for (let i = state.bonuses.length - 1; i >= 0; i--) {
        const b = state.bonuses[i];
        b.position.z += effectiveSpeed * dt;
        b.rotation.y += dt * 3; b.rotation.x += dt * 2;
        if (b.position.z > 12) { scene.remove(b); state.bonuses.splice(i, 1); }
    }

    updateParticles(dt);

    state.spawnTimer += dt;
    if (state.spawnTimer > 0.85) { state.spawnTimer = 0; spawnObstaclePattern(); }
    state.coinTimer += dt;
    if (state.coinTimer > 0.7) { state.coinTimer = 0; spawnCoin(); }
    if (state.bonusJetpack > 0 && Math.random() < 0.06) spawnJetpackRing();
    state.bonusTimer += dt;
    if (state.bonusTimer > 10) { state.bonusTimer = 0; if (Math.random() < .5) spawnBonus(); }
    state.platformTimer += dt;
    if (state.platformTimer > 14) { state.platformTimer = 0; if (Math.random() < .5) spawnPlatform(); }

    state.baseSpeed = Math.min(state.baseSpeed + 0.028 * dt * 60, 24);

    checkCollisions();
    updateWeather(dt);
    updateCameraSpecial(dt);
    updateCameraTarget(dt);

    _achFlushTimer += dt;
    if (_achFlushTimer > 0.2) { _achFlushTimer = 0; flushAchievements(); }

    state.lastHudUpdate += dt;
    if (state.lastHudUpdate > 0.1) { state.lastHudUpdate = 0; updateHUD(); }
}

function animate(now) {
    requestAnimationFrame(animate);
    let dt = (now - lastTime) / 1000;
    lastTime = now;
    if (dt > 0.25) dt = 0.25;
    accumulator += dt;
    let steps = 0;
    while (accumulator >= FIXED_DT && steps < 6) { update(FIXED_DT); accumulator -= FIXED_DT; steps++; }
    if (!state.cutsceneActive && (!state.playing || state.paused)) updateCameraTarget(dt);
    if (state.inMenu && !state.cutsceneActive) playerGroup.rotation.y = (performance.now() / 8000) % (Math.PI * 2);
    else if (!state.rolling && !state.cutsceneActive) playerGroup.rotation.y = 0;
    if (!state.paused) renderer.render(scene, camera);
}

