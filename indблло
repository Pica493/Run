<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>3D Побег из города</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;user-select:none;-webkit-tap-highlight-color:transparent}
html,body{overflow:hidden;background:#0a0a1a;font-family:'Courier New',monospace;touch-action:none;height:100%;overscroll-behavior:none;position:fixed;width:100%}
#gameCanvas{display:block;width:100vw;height:100vh}
#hud{position:fixed;top:12px;left:12px;color:#fff;font-size:15px;font-weight:bold;text-shadow:0 2px 6px #000;pointer-events:none;z-index:5;line-height:1.5;transition:opacity .15s}
#hud.hidden-hud{opacity:0;visibility:hidden}
#hud .coins{color:#ffd700}
#hud .zone{font-size:11px;color:#aac;opacity:.85}
#hud .timer{font-size:16px;color:#4ce0ff;font-weight:bold}
#powerups{position:fixed;top:60px;left:12px;z-index:6;display:flex;flex-direction:column;gap:6px;pointer-events:none}
.pw-item{display:flex;align-items:center;gap:8px;background:rgba(0,0,0,.7);padding:6px 12px;border-radius:20px;color:#fff;font-size:13px;font-weight:bold;border:2px solid #fff}
.pw-item.shield{border-color:#4ce0ff;color:#4ce0ff}
.pw-item.magnet{border-color:#ff66cc;color:#ff66cc}
.pw-item.sneakers{border-color:#66ff66;color:#66ff66}
.pw-item.jetpack{border-color:#ff9f4a;color:#ff9f4a}
.ico{width:1.1em;height:1.1em;vertical-align:-0.2em;display:inline-block}
.ico-lg{width:1.6em;height:1.6em;vertical-align:-0.3em;display:inline-block}
.overlay{position:fixed;inset:0;display:none;flex-direction:column;align-items:center;color:#fff;z-index:20;text-align:center;padding:20px 16px;background:rgba(10,10,30,.82);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);overflow-y:auto;-webkit-overflow-scrolling:touch;touch-action:pan-y}
.overlay.active{display:flex}
.overlay::before,.overlay::after{content:'';flex:1 0 auto;min-height:10px}
.overlay > *{flex-shrink:0}
.overlay h1{font-size:28px;color:#e94560;margin-bottom:10px;text-shadow:0 0 20px #e94560;display:flex;align-items:center;gap:8px;justify-content:center}
.overlay h1 svg{width:30px;height:30px}
.overlay p{font-size:14px;margin:3px 0;color:#cfd6ff}
.overlay p .accent{color:#ffd700;font-weight:bold}
.overlay button{margin-top:8px;padding:11px 20px;font-size:14px;font-weight:bold;background:linear-gradient(180deg,#ffe066,#ffd700);color:#1a1a2e;border:none;border-radius:30px;cursor:pointer;box-shadow:0 4px 0 #b8960f;font-family:inherit;transition:.05s linear;display:inline-flex;align-items:center;gap:6px;justify-content:center}
.overlay button svg{width:1.2em;height:1.2em}
.overlay button:active{transform:translateY(4px);box-shadow:none}
.overlay button.secondary{background:linear-gradient(180deg,#3a3a5a,#2a2a4a);color:#fff;box-shadow:0 4px 0 #14142a}
.overlay button.gold{background:linear-gradient(180deg,#ffe066,#ff9f4a);color:#2a1a00;box-shadow:0 4px 0 #b8842e}
.overlay button:disabled{opacity:.5;pointer-events:none}
.btn-stack{display:flex;flex-direction:column;gap:8px;margin-top:14px;width:100%;max-width:280px}
.btn-stack button{width:100%}
#startScreen{background:rgba(10,10,30,.55)}
.coins-display{color:#ffd700;font-size:16px;margin-top:6px;font-weight:bold;display:flex;align-items:center;gap:6px;justify-content:center}
.controls-info{font-size:11px;color:#8b93c9;max-width:340px;line-height:1.55;margin-top:10px;background:rgba(255,255,255,.05);padding:10px 12px;border-radius:12px}
.grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;max-width:460px;width:100%;margin:14px 0;padding:4px}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;max-width:420px;width:100%;margin:14px 0;padding:4px}
.card{background:linear-gradient(180deg,#1e1e35,#14142a);border:2px solid #2a2a4a;border-radius:12px;padding:8px;cursor:pointer;transition:.15s;text-align:center;color:#fff;font-size:12px}
.card.selected{border-color:#ffd700;box-shadow:0 0 14px rgba(255,215,0,.6)}
.card.owned{border-color:#4caf50}
.card:active{transform:scale(.96)}
.card .preview{width:100%;aspect-ratio:1;border-radius:8px;margin-bottom:6px;background:#0d0d1a;display:block}
.card .name{font-size:11px;color:#fff;margin-bottom:2px;font-weight:bold}
.card .price{font-size:12px;color:#ffd700;font-weight:bold;display:flex;align-items:center;gap:3px;justify-content:center}
.card.owned .price{color:#4caf50}
.achievement-card{display:flex;align-items:center;gap:10px;padding:10px 14px;background:linear-gradient(180deg,#1e1e35,#14142a);border-radius:10px;border:2px solid #2a2a4a;text-align:left;width:100%;max-width:380px}
.achievement-card.unlocked{border-color:#ffd700;background:linear-gradient(180deg,rgba(255,215,0,.12),rgba(255,215,0,.05))}
.achievement-card .icon{font-size:22px;width:32px;text-align:center;flex-shrink:0}
.achievement-card .text{flex:1;min-width:0}
.achievement-card .title{font-size:13px;font-weight:bold;color:#fff}
.achievement-card .desc{font-size:11px;color:#aaa}
.leaderboard-row{display:flex;align-items:center;gap:12px;padding:10px 16px;background:#1a1a2e;border-radius:10px;margin-bottom:8px;width:100%;max-width:380px;font-size:15px}
.leaderboard-row.me{border:2px solid #ffd700}
.leaderboard-row .rank{color:#ffd700;font-weight:bold;width:32px;flex-shrink:0}
.leaderboard-row .nick{flex:1;color:#fff;text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.leaderboard-row .score{color:#4ce0ff;font-weight:bold;flex-shrink:0}
.mission-item{display:flex;align-items:center;gap:10px;padding:10px 14px;background:#1a1a2e;border-radius:10px;border:2px solid #2a2a4a;width:100%;max-width:380px;text-align:left}
.mission-item.done{border-color:#4caf50;background:rgba(76,175,80,.1)}
.mission-item .progress{font-size:11px;color:#888}
.mission-item .reward{color:#ffd700;font-size:12px;font-weight:bold;flex-shrink:0;display:flex;align-items:center;gap:3px}
.wheel-wrap{position:relative;width:250px;height:250px;margin:10px 0;flex-shrink:0}
#wheelCanvas{width:100%;height:100%;border-radius:50%;box-shadow:0 0 30px rgba(255,215,0,.5);display:block}
.wheel-pointer{position:absolute;top:-8px;left:50%;transform:translateX(-50%);width:0;height:0;border-left:16px solid transparent;border-right:16px solid transparent;border-top:24px solid #e94560;z-index:2;filter:drop-shadow(0 2px 4px #000)}
#pauseBtn{position:fixed;top:12px;right:12px;z-index:15;width:40px;height:40px;border-radius:50%;background:rgba(10,10,26,.7);border:none;color:#fff;font-size:18px;cursor:pointer;display:none;align-items:center;justify-content:center}
#toast{position:fixed;top:80px;left:50%;transform:translateX(-50%) translateY(-20px);background:linear-gradient(135deg,#ffd700,#ff9f4a);color:#1a1a2e;padding:12px 24px;border-radius:30px;font-weight:bold;font-size:14px;z-index:100;opacity:0;transition:.4s;pointer-events:none;box-shadow:0 6px 24px rgba(255,215,0,.4);max-width:90vw;text-align:center}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#quickCoins{position:fixed;top:12px;right:60px;z-index:15;background:rgba(10,10,26,.75);color:#ffd700;padding:6px 14px;border-radius:20px;font-weight:bold;font-size:14px;display:flex;align-items:center;gap:6px}
#quickCoins.hidden-q{display:none}

#splashScreen{position:fixed;inset:0;z-index:200;display:flex;flex-direction:column;align-items:center;justify-content:center;background:radial-gradient(ellipse at center top, #2a1a4a 0%, #0a0a1a 70%);overflow:hidden;animation:splashFade 0.6s ease-out;transition:opacity .6s ease-out}
#splashScreen.hide{opacity:0;pointer-events:none}
@keyframes splashFade{from{opacity:0}to{opacity:1}}
#splashScreen::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 15% 20%, rgba(233,69,96,.3) 0%, transparent 30%),radial-gradient(circle at 85% 70%, rgba(76,224,255,.25) 0%, transparent 35%),radial-gradient(circle at 50% 100%, rgba(255,215,0,.15) 0%, transparent 40%);pointer-events:none}
.splash-bg-cars{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.splash-city{position:absolute;bottom:0;left:0;width:100%;height:180px;background:linear-gradient(180deg, transparent 0%, #1a1a2e 40%, #0d0d1a 100%);clip-path:polygon(0 100%, 0 30%, 5% 30%, 5% 55%, 10% 55%, 10% 20%, 15% 20%, 15% 40%, 22% 40%, 22% 10%, 28% 10%, 28% 50%, 34% 50%, 34% 25%, 40% 25%, 40% 45%, 46% 45%, 46% 15%, 52% 15%, 52% 60%, 58% 60%, 58% 30%, 64% 30%, 64% 50%, 70% 50%, 70% 20%, 76% 20%, 76% 45%, 82% 45%, 82% 15%, 88% 15%, 88% 55%, 94% 55%, 94% 35%, 100% 35%, 100% 100%)}
.splash-windows{position:absolute;inset:0;background-image:repeating-linear-gradient(0deg, transparent 0, transparent 12px, rgba(255,215,0,.35) 12px, rgba(255,215,0,.35) 14px),repeating-linear-gradient(90deg, transparent 0, transparent 14px, rgba(76,224,255,.25) 14px, rgba(76,224,255,.25) 15px);background-size:60px 30px;mix-blend-mode:screen;opacity:0.7;animation:windowFlicker 3s infinite alternate}
@keyframes windowFlicker{0%,100%{opacity:.5}50%{opacity:.9}}
.splash-title{position:relative;z-index:2;text-align:center;margin-bottom:20px;animation:titleSlide 0.8s ease-out 0.3s backwards}
@keyframes titleSlide{from{transform:translateY(-40px);opacity:0}to{transform:translateY(0);opacity:1}}
.splash-title .num{font-size:110px;font-weight:900;line-height:1;background:linear-gradient(180deg,#ffe066 0%,#ff9f4a 50%,#e94560 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;text-shadow:0 0 40px rgba(255,215,0,.6);filter:drop-shadow(0 4px 0 #8b0000) drop-shadow(0 8px 16px rgba(0,0,0,.8));letter-spacing:-6px;animation:numPulse 2s ease-in-out infinite alternate}
@keyframes numPulse{from{transform:scale(1)}to{transform:scale(1.03)}}
.splash-title .line1{font-size:22px;color:#fff;letter-spacing:6px;font-weight:bold;text-shadow:0 0 20px #e94560, 0 2px 0 #000;margin-top:-5px}
.splash-title .line2{font-size:38px;color:#4ce0ff;letter-spacing:8px;font-weight:900;text-shadow:0 0 30px #4ce0ff, 0 3px 0 #0a2a4a;margin-top:2px}
.splash-title .subtitle{font-size:13px;color:#aac;letter-spacing:4px;margin-top:16px}
#splashStartBtn{position:relative;z-index:2;margin-top:30px;padding:16px 50px;font-size:20px;font-weight:bold;background:linear-gradient(180deg,#ffe066,#ff9f4a);color:#1a1a2e;border:none;border-radius:40px;cursor:pointer;box-shadow:0 6px 0 #8b4513, 0 0 30px rgba(255,215,0,.4);font-family:inherit;letter-spacing:2px;animation:btnPop 0.6s ease-out 1.2s backwards;transition:.05s linear}
@keyframes btnPop{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}
#splashStartBtn:active{transform:translateY(6px);box-shadow:0 0 0 #8b4513}
.splash-fog{position:absolute;bottom:0;left:0;width:100%;height:200px;background:linear-gradient(180deg, transparent 0%, rgba(10,10,30,.9) 80%);pointer-events:none}

#cutsceneOverlay{position:fixed;inset:0;z-index:150;background:#000;display:none;flex-direction:column;align-items:center;justify-content:space-between;padding:20px}
#cutsceneOverlay.active{display:flex}
#cutsceneSubtitle{color:#fff;font-size:20px;text-align:center;text-shadow:0 0 15px #000,0 3px 6px #000;background:linear-gradient(180deg,rgba(0,0,0,.75),rgba(0,0,0,.5));padding:12px 24px;border-radius:14px;max-width:90%;margin-top:60px;opacity:0;transform:translateY(10px);transition:opacity .5s,transform .5s;font-weight:bold;letter-spacing:1px}
#cutsceneSubtitle.show{opacity:1;transform:translateY(0)}
#skipCutsceneBtn{padding:8px 20px;background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.3);border-radius:20px;font-size:14px;cursor:pointer;font-family:inherit;align-self:flex-end}
#skipCutsceneBtn:active{background:rgba(255,255,255,.3)}
#cutsceneProgress{width:80%;max-width:400px;height:4px;background:rgba(255,255,255,.15);border-radius:2px;overflow:hidden;margin-bottom:20px}
#cutsceneProgressBar{height:100%;width:0%;background:linear-gradient(90deg,#e94560,#ffd700);transition:width .1s linear}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-coin" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#FFD700" stroke="#8B6914" stroke-width="1.5"/><circle cx="12" cy="12" r="7.5" fill="#FFC700" stroke="#B8860B" stroke-width="1"/><circle cx="9" cy="9" r="2" fill="#FFF5B0" opacity=".8"/><text x="12" y="16" font-size="11" text-anchor="middle" fill="#8B6914" font-weight="900" font-family="Arial">₽</text></symbol>
    <symbol id="i-shop" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 4h2l2.5 12h12l2-8H6"/><circle cx="9" cy="20" r="1.5" fill="currentColor"/><circle cx="18" cy="20" r="1.5" fill="currentColor"/></symbol>
    <symbol id="i-trophy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 4h10v5a5 5 0 01-10 0V4z" fill="#FFD700" stroke="#B8860B"/><path d="M7 6H4v2a3 3 0 003 3M17 6h3v2a3 3 0 01-3 3"/><path d="M12 14v4M9 22h6M9 20h6"/></symbol>
